<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <!-- What the guards read as text. CI selects this suite for a change under either. -->
        <TestSelectionDirectory Include="../../src" />
        <TestSelectionDirectory Include="../../test" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Capacitor.Tests.Helpers\Capacitor.Tests.Helpers.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="TUnit" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Capacitor.Tests.Helpers" />
    </ItemGroup>
</Project>
