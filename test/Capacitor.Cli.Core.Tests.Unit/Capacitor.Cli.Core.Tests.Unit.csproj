<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <None Include="../fixtures/pull-request-reads-v1.json" Link="fixtures/pull-request-reads-v1.json" CopyToOutputDirectory="PreserveNewest" />
        <None Include="../fixtures/gh/*.json" Link="fixtures/gh/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <None Include="../fixtures/codex/*.jsonl" Link="fixtures/codex/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <None Include="../fixtures/pi-headless/*.jsonl" Link="fixtures/pi-headless/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <None Include="../fixtures/opencode-headless/*" Link="fixtures/opencode-headless/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <None Include="../fixtures/eval-evidence/*.json" Link="fixtures/eval-evidence/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
        <None Include="../fixtures/eval-strategies/**/*" Link="fixtures/eval-strategies/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <!-- MemoryIndexLiveCertHarness declares native LibraryImports. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <!-- The shipped plugin, read as text. CI selects this suite for a markdown change under it. -->
        <TestSelectionDirectory Include="../../kcap" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Capacitor.Tests.Helpers\Capacitor.Tests.Helpers.csproj" />
        <ProjectReference Include="..\..\src\Capacitor.Cli.Core\Capacitor.Cli.Core.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="Tomlyn" />
        <PackageReference Include="WireMock.Net" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Capacitor.Tests.Helpers" />
        <Using Include="Capacitor.Models.Transcripts" />
    </ItemGroup>
</Project>
