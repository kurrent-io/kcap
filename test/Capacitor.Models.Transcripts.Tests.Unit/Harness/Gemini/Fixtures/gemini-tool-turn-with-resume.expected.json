          "callId": "read_file__read_file_1781705412268_2",
          "result": "from utils import format_task\n\n\nclass TaskBoard:\n    def __init__(self):\n        self._tasks = []\n\n    def add(self, title, done=False):\n        self._tasks.append({\u0022title\u0022: title, \u0022done\u0022: done})\n\n    def pending(self):\n        return [t for t in self._tasks if not t[\u0022done\u0022]]\n\n    def render(self):\n        return \u0022\\n\u0022.join(format_task(i, t) for i, t in enumerate(self._tasks))\n\n\nif __name__ == \u0022__main__\u0022:\n    board = TaskBoard()\n    board.add(\u0022Write capture fixtures\u0022, done=True)\n    board.add(\u0022Normalize Gemini transcript\u0022)\n    board.add(\u0022Add gemini harness chip\u0022)\n    print(board.render())\n",
