<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.App"
             Name="kcap"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://kcap-desktop/Design/Palette.axaml" />
                <ResourceInclude Source="avares://kcap-desktop/Design/Brand.axaml" />
                <ResourceInclude Source="avares://kcap-desktop/Design/Typography.axaml" />
                <ResourceInclude Source="avares://kcap-desktop/Design/Metrics.axaml" />
                <ResourceInclude Source="avares://kcap-desktop/Design/Themes.axaml" />
                <ResourceInclude Source="avares://kcap-desktop/Views/PendingCardTemplates.axaml" />
                <ResourceInclude Source="avares://kcap-desktop/Views/Onboarding/OnboardingResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://MarkView.Avalonia/Themes/MarkdownTheme.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Views/MarkdownStyles.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Views/PullRequestStyles.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Views/ChatBubbleStyles.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Views/Onboarding/OnboardingStyles.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Views/StatusStyles.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Views/NoticeStyles.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Design/Overlays.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Design/Fields.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Design/Text.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Design/Buttons.axaml" />
        <!-- A refresh glyph turning while its read is in flight: the click's only feedback when
             the result is unchanged. Only BusyIndicator.IsBusy applies the class. -->
        <Style Selector="views|AppIcon.kcapSpinning">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- A prompt card that takes dropped files. The resting border lives here rather than on
             the card so the drag-over ring can outrank it: a local value on the control beats
             every style, and a style closer to the control beats one declared here — which is why
             the resting brush cannot stay behind in the view either. -->
        <Style Selector="Border.attachTarget">
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
        </Style>
        <Style Selector="Border.goalNudgeRing">
            <Setter Property="BorderBrush" Value="{StaticResource KcapInfoBrush}" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.goalNudgeRing.on">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.attachTarget.dragOver">
            <Setter Property="BorderBrush" Value="{StaticResource KcapPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.toolKindChip">
            <Setter Property="FontSize" Value="{StaticResource KcapFontSizeSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.chatTime">
            <Setter Property="FontSize" Value="{StaticResource KcapFontSizeCaption}" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <StyleInclude Source="avares://kcap-desktop/Design/Scroll.axaml" />
        <StyleInclude Source="avares://kcap-desktop/Views/SectionStyles.axaml" />
        <Style Selector="Button.acpOption, ToggleButton.acpOption">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="ToggleButton.acpOption:checked">
            <Setter Property="Background" Value="{StaticResource KcapInfoDimBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapInfoBrush}" />
        </Style>
        <Style Selector="ToggleButton.acpOption:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapInfoDimBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapInfoBrush}" />
        </Style>
        <Style Selector="Button.acpOption /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.acpOption /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.acpOption:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.acpOption:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.acpOption:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.acpOption:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="ToggleButton.acpOption:checked /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.acpOption:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.acpOption:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapInfoDimBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapInfoBrush}" />
        </Style>
        <Style Selector="Button.acpOption:focus-visible /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.acpOption:focus-visible /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.acpOption:checked:focus-visible /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.acpOption:checked:pointerover:focus-visible /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.acpOption:checked:pressed:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.acpOption:disabled /template/ ContentPresenter#PART_ContentPresenter,
                         ToggleButton.acpOption:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
            <Setter Property="Opacity" Value="{StaticResource KcapDisabledOpacity}" />
        </Style>
        <Style Selector="Button.kcapVendorTab.active /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapVendorTab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.kcapVendorTab.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.kcapVendorTab.active:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.artefactRow:disabled /template/ ContentPresenter#PART_ContentPresenter,
                         Button.sectionHeader:disabled /template/ ContentPresenter#PART_ContentPresenter,
                         Button.copyValue:disabled /template/ ContentPresenter#PART_ContentPresenter,
                         Button.railRow:disabled /template/ ContentPresenter#PART_ContentPresenter,
                         Button.railPr:disabled /template/ ContentPresenter#PART_ContentPresenter,
                         Button.toolSummary:disabled /template/ ContentPresenter#PART_ContentPresenter,
                         Button.taskRow:disabled /template/ ContentPresenter#PART_ContentPresenter,
                         Button.nwbRow:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
            <Setter Property="Opacity" Value="{StaticResource KcapDisabledOpacity}" />
        </Style>
    </Application.Styles>
</Application>
