<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="KcapFontSizeCaption">11</x:Double>
    <x:Double x:Key="KcapFontSizeSmall">12</x:Double>
    <x:Double x:Key="KcapFontSizeBody">13</x:Double>
    <x:Double x:Key="KcapFontSizeLarge">15</x:Double>
    <x:Double x:Key="KcapFontSizeHeading">19</x:Double>
    <x:Double x:Key="KcapFontSizeTitle">22</x:Double>
    <x:Double x:Key="KcapFontSizeDisplay">28</x:Double>
    <FontFamily x:Key="KcapFontFamilyMono">Menlo,Monaco,Consolas,Cascadia Mono,DejaVu Sans Mono,monospace</FontFamily>
</ResourceDictionary>
