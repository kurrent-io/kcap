<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="KcapCanvasBrush" Color="#202123" />
    <SolidColorBrush x:Key="KcapSurfaceBrush" Color="#262729" />
    <SolidColorBrush x:Key="KcapSurfaceRaisedBrush" Color="#2D2E30" />
    <SolidColorBrush x:Key="KcapBorderBrush" Color="#363739" />
    <SolidColorBrush x:Key="KcapChoiceBorderBrush" Color="#858789" />
    <SolidColorBrush x:Key="KcapBorderStrongBrush" Color="#5A5B5E" />
    <SolidColorBrush x:Key="KcapTextBrush" Color="#E2E2E0" />
    <SolidColorBrush x:Key="KcapMutedBrush" Color="#BDBEBD" />
    <SolidColorBrush x:Key="KcapFaintBrush" Color="#B0B1B0" />
    <SolidColorBrush x:Key="KcapPlaceholderBrush" Color="#B0B1B0" />
    <SolidColorBrush x:Key="KcapFieldBorderBrush" Color="#858789" />
    <SolidColorBrush x:Key="ProgressiveDisclosureDetailFadeBrush" Color="#99E2E2E0" />
    <SolidColorBrush x:Key="ProgressiveDisclosureFootnoteFadeBrush" Color="#4CE2E2E0" />
    <SolidColorBrush x:Key="ProgressiveDisclosureDetailCodeFadeBrush" Color="#992D2E30" />
    <SolidColorBrush x:Key="ProgressiveDisclosureFootnoteCodeFadeBrush" Color="#4C2D2E30" />
    <SolidColorBrush x:Key="KcapPrimaryBrush" Color="#D6D6D1" />
    <SolidColorBrush x:Key="KcapPrimaryHoverBrush" Color="#E4E4DF" />
    <SolidColorBrush x:Key="KcapPrimaryPressedBrush" Color="#C0C1BB" />
    <SolidColorBrush x:Key="KcapOnPrimaryBrush" Color="#262726" />
    <SolidColorBrush x:Key="KcapSuccessBrush" Color="#64D998" />
    <SolidColorBrush x:Key="KcapSuccessDimBrush" Color="#25372D" />
    <SolidColorBrush x:Key="KcapWarningBrush" Color="#EBB64F" />
    <SolidColorBrush x:Key="KcapWarningDimBrush" Color="#382F22" />
    <SolidColorBrush x:Key="KcapPurpleBrush" Color="#C6A0F6" />
    <SolidColorBrush x:Key="KcapPurpleDimBrush" Color="#342B40" />
    <SolidColorBrush x:Key="KcapActivityBrush" Color="#E2E2E0" />
    <SolidColorBrush x:Key="KcapActivityDimBrush" Color="#38393B" />
    <SolidColorBrush x:Key="KcapPrOpenBrush" Color="#64D998" />
    <SolidColorBrush x:Key="KcapPrMergedBrush" Color="#C6A0F6" />
    <SolidColorBrush x:Key="KcapPrClosedBrush" Color="#FF9087" />
    <SolidColorBrush x:Key="KcapPrMergedTipBrush" Color="#C6A0F6" />
    <SolidColorBrush x:Key="KcapDangerBrush" Color="#FF9087" />
    <SolidColorBrush x:Key="KcapDangerDimBrush" Color="#3E282A" />
    <SolidColorBrush x:Key="KcapInfoBrush" Color="#86B9F0" />
    <SolidColorBrush x:Key="KcapInfoDimBrush" Color="#283442" />
    <SolidColorBrush x:Key="KcapControlHoverBrush" Color="#333436" />
    <SolidColorBrush x:Key="KcapControlPressedBrush" Color="#3A3B3D" />
    <SolidColorBrush x:Key="KcapSelectionBrush" Color="#304151" />
    <SolidColorBrush x:Key="KcapTopicRailBrush" Color="#BDBEBD" Opacity="0.55" />
    <SolidColorBrush x:Key="KcapTopicBrush" Color="#BDBEBD" />
    <SolidColorBrush x:Key="KcapBookmarkRedBrush" Color="#E2A8A8" />
    <SolidColorBrush x:Key="KcapBookmarkOrangeBrush" Color="#DDB18E" />
    <SolidColorBrush x:Key="KcapBookmarkYellowBrush" Color="#DFCA95" />
    <SolidColorBrush x:Key="KcapBookmarkGreenBrush" Color="#9BC9AC" />
    <SolidColorBrush x:Key="KcapBookmarkBlueBrush" Color="#A2BFDE" />
    <SolidColorBrush x:Key="KcapBookmarkPurpleBrush" Color="#C4B7DD" />
    <SolidColorBrush x:Key="KcapBookmarkPinkBrush" Color="#D5AFCA" />
    <SolidColorBrush x:Key="KcapBookmarkGreyBrush" Color="#BDBEBD" />
    <Color x:Key="ScrollBarThumbBackgroundColor">#3A66B8</Color>
    <Color x:Key="ScrollBarPanningThumbBackgroundColor">#3A66B8</Color>
    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#96A8BB" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#86B9F0" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#A5CBF3" />
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#283442" />
    <SolidColorBrush x:Key="ScrollBarTrackStroke" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarTrackStrokePointerOver" Color="#304151" />
    <SolidColorBrush x:Key="ScrollBarBackground" Color="#00000000" />
    <ScaleTransform x:Key="VerticalSmallScrollThumbScaleTransform" ScaleX="1" ScaleY="1" />
    <ScaleTransform x:Key="HorizontalSmallScrollThumbScaleTransform" ScaleX="1" ScaleY="1" />
    <SolidColorBrush x:Key="ScrollBarBackgroundPointerOver" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarButtonBackground" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="#00000000" />
    <SolidColorBrush x:Key="ScrollViewerScrollBarsSeparatorBackground" Color="#00000000" />
</ResourceDictionary>
