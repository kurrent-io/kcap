<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Capacitor.App.Views">
    <Style Selector="ScrollBar">
        <Setter Property="views:PreviewMotion.IsReduced" Value="{DynamicResource KcapReducePreviewMotion}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ContextFlyout" Value="{x:Null}" />
    </Style>
    <Style Selector="ScrollViewer:not(:scrolling) /template/ ScrollBar[AllowAutoHide=True][IsExpanded=False]">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ScrollBar[AllowAutoHide=True]">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
    </Style>
    <Style Selector="ScrollBar /template/ Border#VerticalRoot,
                     ScrollBar /template/ Border#HorizontalRoot,
                     ScrollBar:pointerover /template/ Border#VerticalRoot,
                     ScrollBar:pointerover /template/ Border#HorizontalRoot,
                     ScrollBar:expanded /template/ Border#VerticalRoot,
                     ScrollBar:expanded /template/ Border#HorizontalRoot">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ScrollBar /template/ Rectangle#TrackRect">
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="RadiusX" Value="6" />
        <Setter Property="RadiusY" Value="6" />
        <Setter Property="Margin" Value="1,2" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:expanded /template/ Rectangle#TrackRect">
        <Setter Property="Fill" Value="{StaticResource KcapInfoDimBrush}" />
        <Setter Property="Stroke" Value="{StaticResource KcapSelectionBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton,
                     ScrollBar /template/ RepeatButton#PART_LineDownButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ScrollBar /template/ RepeatButton#PART_PageUpButton,
                     ScrollBar /template/ RepeatButton#PART_PageDownButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb,
                     ScrollBar:vertical /template/ Thumb,
                     ScrollBar:horizontal /template/ Thumb,
                     ScrollBar:vertical:expanded /template/ Thumb,
                     ScrollBar:horizontal:expanded /template/ Thumb">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Template">
            <ControlTemplate TargetType="Thumb">
                <Border Name="ThumbPill"
                        Background="{StaticResource KcapInfoBrush}"
                        Opacity="0.45"
                        CornerRadius="99"
                        RenderTransformOrigin="50%,50%" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb">
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb /template/ Border#ThumbPill">
        <Setter Property="RenderTransform" Value="scale(1, 1)" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb /template/ Border#ThumbPill">
        <Setter Property="Margin" Value="3,2" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb /template/ Border#ThumbPill">
        <Setter Property="Margin" Value="2,3" />
    </Style>
    <Style Selector="ScrollBar:expanded /template/ Thumb /template/ Border#ThumbPill,
                     ScrollBar /template/ Thumb:pointerover /template/ Border#ThumbPill">
        <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="ScrollBar:vertical /template/ Thumb:pressed /template/ Border#ThumbPill">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="scale(0.72, 0.97)" />
    </Style>
    <Style Selector="ScrollBar:horizontal /template/ Thumb:pressed /template/ Border#ThumbPill">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="scale(0.97, 0.72)" />
    </Style>
    <Style Selector="ScrollViewer.turnNavigator /template/ ScrollBar:vertical /template/ Rectangle#TrackRect">
        <Setter Property="Fill" Value="{StaticResource KcapInfoDimBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ScrollViewer.turnNavigator /template/ ScrollBar:vertical /template/ Thumb /template/ Border#ThumbPill">
        <Setter Property="Background" Value="{StaticResource KcapNavigatorThumbBrush}" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="GridSplitter.sidebarSplitter">
        <Setter Property="views:PreviewMotion.IsReduced" Value="{DynamicResource KcapReducePreviewMotion}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWestEast" />
        <Setter Property="Template">
            <ControlTemplate TargetType="GridSplitter">
                <Border Background="Transparent">
                    <Border Name="SplitterLine"
                            Width="2"
                            HorizontalAlignment="Center"
                            Background="{StaticResource KcapBorderBrush}"
                            CornerRadius="99"
                            RenderTransformOrigin="50%,50%" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="GridSplitter.sidebarSplitter /template/ Border#SplitterLine">
        <Setter Property="RenderTransform" Value="scaleX(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="GridSplitter.sidebarSplitter:pointerover /template/ Border#SplitterLine">
        <Setter Property="Background" Value="{StaticResource KcapInfoBrush}" />
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="RenderTransform" Value="scaleX(1.5)" />
    </Style>
    <Style Selector="GridSplitter.sidebarSplitter:pressed /template/ Border#SplitterLine">
        <Setter Property="Background" Value="{StaticResource KcapInfoBrush}" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="scaleX(1.5)" />
    </Style>
    <Style Selector="ScrollBar.reduceMotion[AllowAutoHide=True],
                     ScrollBar.reduceMotion /template/ Rectangle#TrackRect">
        <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
    <Style Selector="ScrollBar.reduceMotion:vertical /template/ Thumb /template/ Border#ThumbPill,
                     ScrollBar.reduceMotion:horizontal /template/ Thumb /template/ Border#ThumbPill,
                     GridSplitter.sidebarSplitter.reduceMotion /template/ Border#SplitterLine">
        <Setter Property="Transitions" Value="{x:Null}" />
        <Setter Property="RenderTransform" Value="none" />
    </Style>
</Styles>
