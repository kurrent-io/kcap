<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="KcapMinTargetSize">24</x:Double>
    <x:Double x:Key="KcapDisabledOpacity">0.5</x:Double>
    <Thickness x:Key="KcapActionPadding">16,8</Thickness>
    <Thickness x:Key="KcapChoicePadding">14,8</Thickness>
    <Thickness x:Key="KcapChatCardPadding">14,10</Thickness>
    <Thickness x:Key="KcapTranscriptGap">0,8,0,12</Thickness>
    <Thickness x:Key="KcapUserTurnPadding">14,11</Thickness>
    <Thickness x:Key="KcapComposerPadding">13,8,13,12</Thickness>
    <Thickness x:Key="KcapSessionRowPadding">8,6</Thickness>
    <x:Int32 x:Key="KcapReadingLayout">0</x:Int32>
    <Thickness x:Key="KcapContextDividerThickness">1,0,0,0</Thickness>
    <x:Double x:Key="KcapTranscriptSelectionOpacity">0.20</x:Double>
    <x:Boolean x:Key="KcapTranscriptSelection">False</x:Boolean>
    <CornerRadius x:Key="KcapControlRadius">8</CornerRadius>
    <CornerRadius x:Key="KcapChatCardRadius">10</CornerRadius>
</ResourceDictionary>
