<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.Views.MessageCopyButton"
             VerticalAlignment="Center">
    <Button x:Name="CopyButton" Classes="kcapGhost kcapIcon messageCopy" Padding="4" MinHeight="0"
            Click="OnCopyClick" ToolTip.Tip="Copy message" AutomationProperties.Name="Copy message">
        <Panel>
            <views:AppIcon x:Name="CopyIcon" Kind="Copy" Size="12" />
            <views:AppIcon x:Name="CopiedIcon" Kind="Check" Size="12" IsVisible="False" />
        </Panel>
    </Button>
</UserControl>
