<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.Views.WorkItemPageView"
             x:DataType="vm:WorkItemPageViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.bar">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.barAction">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.barAction /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="Button.groupHead">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.groupHead /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapRowHoverBrush}" />
        </Style>
        <Style Selector="Button.groupHead:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.groupHead:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapRowActiveBrush}" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{StaticResource KcapRowHoverBrush}" />
        </Style>
        <Style Selector="Border.row Button.makePart">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.row:pointerover Button.makePart, Border.row:focus-within Button.makePart">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.rowButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Button.menuRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.linkSum">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.linkSum /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="StackPanel.groupItems">
            <Setter Property="Spacing" Value="2" />
            <Setter Property="Margin" Value="22,2,0,0" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="LinkRow" x:DataType="vm:WorkItemPageLink">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <views:AppIcon Kind="{Binding Icon}" Size="14" Foreground="{StaticResource KcapFaintBrush}"
                               IsVisible="{Binding !IsMerged}" />
                <views:AppIcon Kind="{Binding Icon}" Size="14" Foreground="{StaticResource KcapSuccessBrush}"
                               IsVisible="{Binding IsMerged}" />
                <TextBlock Grid.Column="1" Text="{Binding ShortKey}" MinWidth="64" Foreground="{StaticResource KcapMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding StateLabel}" FontSize="12.5" Foreground="{StaticResource KcapMutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LinkButton" x:DataType="vm:WorkItemPageLink">
            <Button Classes="kcapGhost rowButton" ToolTip.Tip="{Binding Title}" AutomationProperties.Name="{Binding ShortKey}"
                    Command="{Binding $parent[views:WorkItemPageView].((vm:WorkItemPageViewModel)DataContext).OpenLinkCommand}"
                    CommandParameter="{Binding}" Content="{Binding}" ContentTemplate="{StaticResource LinkRow}" Click="OnFlyoutItemClick" />
        </DataTemplate>

        <DataTemplate x:Key="SessionRow" x:DataType="vm:WorkItemPageSession">
            <Button Classes="kcapGhost rowButton sessionRow"
                    Command="{Binding $parent[views:WorkItemPageView].((vm:WorkItemPageViewModel)DataContext).OpenSessionCommand}"
                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Meta}" FontSize="12.5" Foreground="{StaticResource KcapFaintBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="Part" x:DataType="vm:WorkItemPagePart">
            <StackPanel>
                <Border Classes="row" ToolTip.Tip="{Binding Tip}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="4" MinHeight="34" Margin="4,0,6,0">
                        <Panel Width="24">
                            <Button Classes="kcapGhost kcapIcon" Command="{Binding ToggleCommand}" IsVisible="{Binding HasSessions}"
                                    AutomationProperties.Name="{Binding Title, StringFormat='Show sessions of {0}'}">
                                <Panel Width="14" Height="14">
                                    <views:AppIcon Kind="ChevronDown" Size="14" Classes="chevron" IsVisible="{Binding IsExpanded}" />
                                    <views:AppIcon Kind="ChevronRight" Size="14" Classes="chevron" IsVisible="{Binding !IsExpanded}" />
                                </Panel>
                            </Button>
                        </Panel>
                        <Button Grid.Column="1" Classes="kcapGhost kcapIcon" ToolTip.Tip="{Binding StatusLabel, StringFormat='{}{0}. Set the status by hand'}"
                                AutomationProperties.Name="{Binding StatusLabel, StringFormat='Status {0}'}">
                            <views:AppIcon Kind="{Binding Icon}" Size="14"
                                           Foreground="{Binding Status, Converter={x:Static views:WorkStatusBrushConverter.Instance}}" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="kcapPanel">
                                    <StackPanel Spacing="2" Margin="6" MinWidth="160">
                                        <Button Classes="kcapGhost menuRow" Command="{Binding SetStatusCommand}" CommandParameter="in_progress" Click="OnFlyoutItemClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <views:AppIcon Kind="CircleDot" Size="14" Foreground="{StaticResource KcapPurpleBrush}" />
                                                <TextBlock Text="In progress" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="kcapGhost menuRow" Command="{Binding SetStatusCommand}" CommandParameter="in_review" Click="OnFlyoutItemClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <views:AppIcon Kind="Contrast" Size="14" Foreground="{StaticResource KcapInfoBrush}" />
                                                <TextBlock Text="In review" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="kcapGhost menuRow" Command="{Binding SetStatusCommand}" CommandParameter="blocked" Click="OnFlyoutItemClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <views:AppIcon Kind="CircleSlash" Size="14" Foreground="{StaticResource KcapWarningBrush}" />
                                                <TextBlock Text="Blocked" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="kcapGhost menuRow" Command="{Binding SetStatusCommand}" CommandParameter="open" Click="OnFlyoutItemClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <views:AppIcon Kind="Circle" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                                                <TextBlock Text="Open" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="kcapGhost menuRow" Command="{Binding SetStatusCommand}" CommandParameter="done" Click="OnFlyoutItemClick">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <views:AppIcon Kind="CircleCheck" Size="14" Foreground="{StaticResource KcapSuccessBrush}" />
                                                <TextBlock Text="Done" />
                                            </StackPanel>
                                        </Button>
                                        <Border Height="1" Margin="4" Background="{StaticResource KcapBorderBrush}" />
                                        <Button Classes="kcapGhost menuRow" Content="Work it out from links" Command="{Binding SetStatusCommand}"
                                                CommandParameter="" Click="OnFlyoutItemClick" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Margin="4,0,0,0" />
                        <Border Grid.Column="3" Background="{StaticResource KcapWarningDimBrush}" CornerRadius="9" Padding="7,1"
                                VerticalAlignment="Center" IsVisible="{Binding NeedsYou}">
                            <TextBlock Text="Needs you" FontSize="12.5" Foreground="{StaticResource KcapWarningBrush}" />
                        </Border>
                        <Button Grid.Column="4" Classes="kcapGhost linkSum" IsVisible="{Binding HasLinks}" ToolTip.Tip="{Binding LinkTip}"
                                AutomationProperties.Name="{Binding LinkTip, StringFormat='Links: {0}'}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <views:AppIcon Kind="GitPullRequest" Size="12" IsVisible="{Binding HasPrs}" />
                                <TextBlock Text="{Binding PrSummary}" IsVisible="{Binding HasPrs}" Margin="0,0,4,0" />
                                <views:AppIcon Kind="CircleDot" Size="12" IsVisible="{Binding HasIssues}" />
                                <TextBlock Text="{Binding IssueSummary}" IsVisible="{Binding HasIssues}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="kcapPanel">
                                    <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkButton}" Margin="6" MinWidth="340" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </Border>
                <Border BorderThickness="1,0,0,0" BorderBrush="{StaticResource KcapBorderStrongBrush}" Margin="16,2,0,4"
                        IsVisible="{Binding IsExpanded}">
                    <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionRow}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Group" x:DataType="vm:WorkItemPageGroupViewModel">
            <StackPanel>
                <Button Classes="kcapGhost groupHead" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Label}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Panel Width="14" Height="14">
                            <views:AppIcon Kind="ChevronDown" Size="14" Classes="chevron" IsVisible="{Binding IsExpanded}" />
                            <views:AppIcon Kind="ChevronRight" Size="14" Classes="chevron" IsVisible="{Binding !IsExpanded}" />
                        </Panel>
                        <views:AppIcon Kind="{Binding Icon}" Size="14"
                                       Foreground="{Binding Status, Converter={x:Static views:WorkStatusBrushConverter.Instance}}" />
                        <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Count}" FontSize="15" Foreground="{StaticResource KcapFaintBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Classes="groupItems" IsVisible="{Binding IsExpanded}">
                    <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkButton}" />
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkItemPublishedPage">
                                <Button Classes="kcapGhost rowButton" ToolTip.Tip="{Binding Url}" AutomationProperties.Name="{Binding Title}"
                                        Command="{Binding $parent[views:WorkItemPageView].((vm:WorkItemPageViewModel)DataContext).OpenPageCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Version}" FontSize="12.5" Foreground="{StaticResource KcapMutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Updated}" FontSize="12.5" Foreground="{StaticResource KcapFaintBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource Part}" />
                    <ItemsControl ItemsSource="{Binding LooseEnds}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkItemPageLooseEnd">
                                <Border Classes="row" Padding="10,4,6,4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="{Binding Text}" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="kcapChip makePart" Content="Make slice"
                                                Command="{Binding $parent[views:WorkItemPageView].((vm:WorkItemPageViewModel)DataContext).MakePartCommand}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Text, StringFormat='Make {0} a slice'}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionRow}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource KcapCanvasBrush}">
        <DockPanel>
            <Border x:Name="WorkItemHeader" DockPanel.Dock="Top" BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="20,16,16,16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="WorkItemTitle" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource KcapTextBrush}" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Title}" />
                        <TextBlock x:Name="WorkItemGoal" Text="{Binding Goal}" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource KcapMutedBrush}" ToolTip.Tip="{Binding Goal}"
                                   IsVisible="{Binding Goal, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <Button x:Name="WorkItemOpenInWeb" Grid.Column="1" Classes="kcapGhost kcapIcon" Command="{Binding OpenInWebCommand}"
                            VerticalAlignment="Center" ToolTip.Tip="Open in the web app" AutomationProperties.Name="Open in the web app">
                        <views:AppIcon Kind="ExternalLink" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer>
                <Grid ColumnDefinitions="*,6*,*" Margin="0,16,0,24">
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock x:Name="WorkItemMessage" Text="{Binding Message}" FontSize="12" Foreground="{StaticResource KcapMutedBrush}"
                                   IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="bar" Text="Resources" />
                            <Button x:Name="AddLinkButton" Grid.Column="1" Classes="kcapGhost barAction" AutomationProperties.Name="Add link">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <views:AppIcon Kind="Plus" Size="12" />
                                    <TextBlock Text="Link" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="kcapPanel">
                                        <StackPanel Spacing="8" Margin="8" Width="260">
                                            <TextBox Classes="kcapField" Text="{Binding NewLinkReference}" PlaceholderText="Issue key or PR"
                                                     AutomationProperties.Name="Issue key or PR" />
                                            <Button Classes="kcapChip" Content="Add link" HorizontalAlignment="Right"
                                                    Command="{Binding AddLinkCommand}" Click="OnFlyoutItemClick" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <ContentControl x:Name="WorkItemLinks" Content="{Binding LinksGroup}" ContentTemplate="{StaticResource Group}"
                                        IsVisible="{Binding LinksGroup, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentControl x:Name="WorkItemPages" Content="{Binding PagesGroup}" ContentTemplate="{StaticResource Group}"
                                        IsVisible="{Binding PagesGroup, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8" Margin="0,8,0,0">
                            <TextBlock Classes="bar" Text="Slices" />
                            <StackPanel x:Name="WorkItemProgress" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        ToolTip.Tip="{Binding ProgressText, StringFormat='{}{0} slices done'}">
                                <Panel Width="16" Height="16" VerticalAlignment="Center">
                                    <Ellipse Stroke="{StaticResource KcapBorderStrongBrush}" StrokeThickness="2.5" />
                                    <Arc StartAngle="-90" SweepAngle="{Binding ProgressSweep}" Stroke="{StaticResource KcapSuccessBrush}"
                                         StrokeThickness="2.5" StrokeLineCap="Round" />
                                </Panel>
                                <TextBlock Text="{Binding ProgressText}" FontSize="15" Foreground="{StaticResource KcapMutedBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="AddPartButton" Grid.Column="3" Classes="kcapGhost barAction" AutomationProperties.Name="Add slice">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <views:AppIcon Kind="Plus" Size="12" />
                                    <TextBlock Text="Slice" />
                                </StackPanel>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="kcapPanel">
                                        <StackPanel Spacing="8" Margin="8" Width="260">
                                            <TextBox Classes="kcapField" Text="{Binding NewPartTitle}" PlaceholderText="Slice title"
                                                     AutomationProperties.Name="Slice title" />
                                            <Button Classes="kcapChip" Content="Add slice" HorizontalAlignment="Right"
                                                    Command="{Binding AddPartCommand}" Click="OnFlyoutItemClick" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <ItemsControl x:Name="WorkItemGroups" ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource Group}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
