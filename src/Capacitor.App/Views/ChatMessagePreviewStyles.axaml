<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Capacitor.App.Views"
        xmlns:vm="clr-namespace:Capacitor.App.ViewModels">
    <!-- Keep the style collection stable across toggles. Live insertion clears style frames on
         Markdown inlines, which have no layout pass to reapply them. -->
    <Style Selector="views|ChatMessageRow">
        <Setter Property="InlineChrome" Value="{DynamicResource KcapInlineMessageChrome}" />
    </Style>
    <Style Selector="views|ChatMessageRow:inline-chrome">
        <Setter Property="ContextFlyout" Value="{x:Static views:TextContextMenu.ForMessageRow}" />
    </Style>
    <Style Selector="views|ChatMessageRow:inline-chrome.noMessageText" x:DataType="views:ChatMessageRow">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{Binding $self.Author}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding $self.Timestamp.Tip}" />
    </Style>
    <Style Selector="views|ChatMessageRow:inline-chrome Border.userTurn">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MaxWidth" Value="Infinity" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="views|ChatMessageRow:inline-chrome Border.userMessageBody">
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="Padding" Value="{DynamicResource KcapUserTurnPadding}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
    </Style>
    <Style Selector="views|ChatMessageRow:inline-chrome Border.undelivered Border.userMessageBody">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="views|ChatMessageRow:inline-chrome views|ChatMessageHeader">
        <Setter Property="BesideMessage" Value="True" />
        <Setter Property="DockPanel.Dock" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="12,0,0,0" />
    </Style>
    <Style Selector="views|ChatMessageRow.userRow:inline-chrome views|ChatMessageHeader" x:DataType="vm:UserTurnItem">
        <Setter Property="DockPanel.Dock" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="ShowParticipant" Value="{Binding Sender.IsOtherParticipant}" />
    </Style>
    <Style Selector="views|ChatMessageRow.userRow:inline-chrome TextBlock.messageAuthor">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="views|ChatMessageRow:inline-chrome views|ChatMessageHeader:not(:participant) TextBlock.messageAuthor">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="views|ChatMessageHeader:participant TextBlock.messageAuthor" x:DataType="TextBlock">
        <Setter Property="ToolTip.Tip" Value="{Binding $parent[views:ChatMessageRow].AccessibleMetadata}" />
    </Style>
    <Style Selector="views|ChatMessageRow:inline-chrome TextBlock.messageAuthor,
                     views|ChatMessageRow:inline-chrome TextBlock.messageTime">
        <Setter Property="MaxWidth" Value="124" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="views|ChatMessageRow:inline-chrome TextBlock.messageTime" x:DataType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        <Setter Property="ToolTip.Tip" Value="{Binding $parent[views:ChatMessageRow].AccessibleMetadata}" />
    </Style>
    <Style Selector="views|ChatMessageRow:inline-chrome TextBlock.messageTime,
                     views|ChatMessageRow:inline-chrome views|MessageCopyButton">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="views|ChatMessageRow:show-details TextBlock.messageTime,
                     views|ChatMessageRow:show-details views|MessageCopyButton,
                     views|ChatMessageRow:show-details Button.topicHere,
                     views|ChatMessageRow:show-details Button.bookmarkHere">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="views|ChatMessageRow:inline-chrome:not(:show-details) Button.topicHere:not(.on),
                     views|ChatMessageRow:inline-chrome:not(:show-details) Button.bookmarkHere:not(.on)">
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="views|ChatMessageRow:inline-chrome views|MessageCopyButton" x:DataType="views:MessageCopyButton">
        <Setter Property="AutomationProperties.HelpText" Value="{Binding $parent[views:ChatMessageRow].AccessibleMetadata}" />
        <Setter Property="MinimumActionHeight" Value="24" />
    </Style>
</Styles>
