<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels.Composer"
             xmlns:core="clr-namespace:Capacitor.Cli.Core;assembly=Capacitor.Cli.Core"
             x:Class="Capacitor.App.Views.ComposerPickerPopup">
    <UserControl.Styles>
        <Style Selector="Button.pickerRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="ContentPresenter.active Button.pickerRow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer x:Name="Scroller" MaxHeight="280" Padding="6">
        <ItemsControl x:Name="Rows">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.DataTemplates>
                <DataTemplate DataType="core:HostedAgentCommand">
                    <Button Classes="kcapGhost pickerRow" Focusable="False" Click="OnRowClick">
                        <Grid ColumnDefinitions="220,*">
                            <TextBlock Text="{Binding Name, StringFormat='/{0}'}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource KcapTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Description}" Margin="12,0,0,0" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource KcapMutedBrush}" />
                        </Grid>
                    </Button>
                </DataTemplate>
                <DataTemplate DataType="vm:FileMention">
                    <Button Classes="kcapGhost pickerRow" Focusable="False" Click="OnRowClick">
                        <Grid ColumnDefinitions="220,*">
                            <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource KcapTextBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Folder}" Margin="12,0,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource KcapMutedBrush}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.DataTemplates>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
