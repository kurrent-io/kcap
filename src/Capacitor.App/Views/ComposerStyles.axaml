<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
        xmlns:views="clr-namespace:Capacitor.App.Views">
    <Style Selector="views|SessionConnectionNotice#ChatConnectionBanner" x:DataType="vm:ChatTabViewModel">
        <Setter Property="IsVisible" Value="{Binding $parent[views:ChatTabView].((vm:ChatTabViewModel)DataContext).ShowsConnectionBanner}" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer views|SessionConnectionNotice#ChatConnectionBanner" x:DataType="vm:ChatTabViewModel">
        <Setter Property="IsVisible" Value="{Binding $parent[views:ChatTabView].((vm:ChatTabViewModel)DataContext).ShowsPreviewConnectionBanner}" />
    </Style>
    <Style Selector="views|SessionConnectionNotice#ChatEmptyState" x:DataType="vm:ChatTabViewModel">
        <Setter Property="DataContext" Value="{Binding $parent[views:ChatTabView].((vm:ChatTabViewModel)DataContext).EmptyState}" />
        <Setter Property="IsVisible" Value="{Binding $parent[views:ChatTabView].((vm:ChatTabViewModel)DataContext).ShowsEmptyState}" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer views|SessionConnectionNotice#ChatEmptyState" x:DataType="vm:ChatTabViewModel">
        <Setter Property="DataContext" Value="{Binding $parent[views:ChatTabView].((vm:ChatTabViewModel)DataContext).PreviewEmptyState}" />
        <Setter Property="IsVisible" Value="{Binding $parent[views:ChatTabView].((vm:ChatTabViewModel)DataContext).ShowsPreviewEmptyState}" />
    </Style>
    <Style Selector="Border#ComposerBand">
        <Setter Property="Padding" Value="22,15,22,16" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer Border#ComposerBand">
        <Setter Property="Padding" Value="22,8,22,10" />
    </Style>
    <Style Selector="Border#AccountStrip" x:DataType="vm:ChatTabViewModel">
        <Setter Property="IsVisible" Value="{Binding ShowsAccountStrip}" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer Border#AccountStrip,
                     views|ChatTabView.previewComposer TextBlock#StockComposerHint,
                     ContentControl.composerFeedback, ContentControl.composerAccount">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer ContentControl.composerFeedback" x:DataType="vm:ChatTabViewModel">
        <Setter Property="Content" Value="{Binding PreviewComposerFeedback}" />
        <Setter Property="IsVisible" Value="{Binding Content, RelativeSource={RelativeSource Self}, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer ContentControl.composerAccount" x:DataType="vm:ChatTabViewModel">
        <Setter Property="Content" Value="{Binding}" />
        <Setter Property="IsVisible" Value="{Binding ShowsAccountStrip}" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer ContentControl.endedAccount" x:DataType="vm:ChatTabViewModel">
        <Setter Property="IsVisible">
            <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="ShowsAccountStrip" />
                <Binding Path="!ShowsComposer" />
            </MultiBinding>
        </Setter>
    </Style>

    <Style Selector="Button#InterruptButton" x:DataType="vm:ChatTabViewModel">
        <Setter Property="IsVisible" Value="{Binding ShowsInterrupt}" />
    </Style>
    <Style Selector="views|ChatTabView.narrowComposer Button#InterruptButton, Button#ComposerMoreButton">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="views|ChatTabView.narrowComposer Button#ComposerMoreButton" x:DataType="vm:ChatTabViewModel">
        <Setter Property="IsVisible" Value="{Binding ShowsInterrupt}" />
    </Style>

    <Style Selector="ScrollViewer.composerOverflow">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector=":is(UserControl).previewComposer ScrollViewer.composerOverflow">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="AllowAutoHide" Value="False" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="False" />
        <Setter Property="MaxHeight" Value="108" />
    </Style>
    <Style Selector=":is(UserControl).previewComposer ScrollViewer.composerOverflow.hasOverflow">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="AutomationProperties.HelpText" Value="Use Page Up and Page Down to scroll." />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer.shortComposer ScrollViewer.composerOverflow,
                     views|HandoffComposerView.previewComposer.shortComposer ScrollViewer.composerOverflow">
        <Setter Property="MaxHeight" Value="72" />
    </Style>

    <Style Selector="TextBox#ComposerInput, TextBox#HandoffInput">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MaxHeight" Value="160" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer TextBox#ComposerInput,
                     views|HandoffComposerView.previewComposer TextBox#HandoffInput">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="MaxHeight" Value="120" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer.shortComposer TextBox#ComposerInput,
                     views|HandoffComposerView.previewComposer.shortComposer TextBox#HandoffInput">
        <Setter Property="MaxHeight" Value="88" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer TextBox#ComposerInput">
        <Setter Property="AutomationProperties.HelpText" Value="Enter sends. Shift+Enter inserts a new line." />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer Border#ComposerCard:not(.dragOver),
                     views|HandoffComposerView.previewComposer Border#HandoffCard:not(.dragOver)">
        <Setter Property="BorderBrush" Value="{StaticResource KcapFieldBorderBrush}" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer Border#ComposerCard:focus-within:not(.dragOver),
                     views|HandoffComposerView.previewComposer Border#HandoffCard:focus-within:not(.dragOver)">
        <Setter Property="BorderBrush" Value="{StaticResource KcapInfoBrush}" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer Button#AttachButton,
                     views|ChatTabView.previewComposer Button#InterruptButton,
                     views|ChatTabView.previewComposer Button#SendButton,
                     views|ChatTabView.previewComposer Button#SendModeButton,
                     views|HandoffComposerView.previewComposer Button.handoffAction">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="views|ChatTabView.previewComposer Button#AttachButton,
                     views|HandoffComposerView.previewComposer Button#HandoffAttachButton">
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
</Styles>
