<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:drv="clr-namespace:Capacitor.App.ViewModels.Driver"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.Views.DriverView"
             x:Name="Root"
             x:DataType="drv:DriverViewModel"
             Background="{StaticResource KcapCanvasBrush}">
    <!-- Colour is status only: warning for what waits on the person, purple for agents working now, success for done
         parts. Titles and goals are user- or tracker-authored, so each is a TextBlock's text. -->
    <UserControl.Styles>
        <Style Selector="TextBlock.drvSection">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
            <Setter Property="Margin" Value="2,18,0,8" />
        </Style>
        <Style Selector="Border.drvCard">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="Border.drvNeed">
            <Setter Property="BorderThickness" Value="3,1,1,1" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapWarningBrush}" />
        </Style>
        <Style Selector="Button.drvRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.drvRow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
        </Style>
        <Style Selector="Button.drvRow:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.drvRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderStrongBrush}" />
        </Style>
        <Style Selector="Button.drvRow:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource KcapInfoBrush}" />
        </Style>
        <Style Selector="Border.drvCell">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapFaintBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.drvCell.done"><Setter Property="Background" Value="{StaticResource KcapSuccessBrush}" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="Border.drvCell.progress"><Setter Property="Background" Value="{StaticResource KcapPurpleBrush}" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="Border.drvCell.review"><Setter Property="Background" Value="{StaticResource KcapWarningBrush}" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="Border.drvCell.blocked"><Setter Property="BorderBrush" Value="{StaticResource KcapWarningBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
        <Style Selector="Border.drvPill">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.drvPill TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" /></Style>
        <Style Selector="Border.drvPill.wait"><Setter Property="BorderBrush" Value="{StaticResource KcapWarningBrush}" /></Style>
        <Style Selector="Border.drvPill.work"><Setter Property="BorderBrush" Value="{StaticResource KcapPurpleBrush}" /></Style>
        <Style Selector="Ellipse.drvDot"><Setter Property="Width" Value="7" /><Setter Property="Height" Value="7" /><Setter Property="Fill" Value="{StaticResource KcapFaintBrush}" /></Style>
        <Style Selector="Ellipse.drvDot.wait"><Setter Property="Fill" Value="{StaticResource KcapWarningBrush}" /></Style>
        <Style Selector="Ellipse.drvDot.work"><Setter Property="Fill" Value="{StaticResource KcapPurpleBrush}" /></Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,Auto">
    <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="24,16,24,0">
        <DockPanel Grid.Row="0" Margin="0,8,0,4">
            <Button x:Name="DriverRefreshButton" DockPanel.Dock="Right" Classes="kcapGhost kcapIcon" Command="{Binding RefreshCommand}"
                    AutomationProperties.Name="Refresh Driver" ToolTip.Tip="Refresh">
                <views:AppIcon Kind="RefreshCw" Size="14" />
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Driver" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource KcapTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding LiveSummary}" FontSize="12" Foreground="{StaticResource KcapMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,24">
                <TextBlock Text="{Binding PhaseText}" IsVisible="{Binding ShowsPhase}" Margin="2,16,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource KcapMutedBrush}" />

                <!-- Overview: what needs the person, then every work item in flight. -->
                <StackPanel IsVisible="{Binding IsOverview}">
                    <TextBlock Classes="drvSection" Text="{Binding NeedsHeader}" IsVisible="{Binding HasNeeds}" />
                    <ItemsControl x:Name="DriverNeeds" ItemsSource="{Binding NeedsYou}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="drv:DriverNeedViewModel">
                                <Border Classes="drvCard drvNeed">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <Border Classes="drvPill wait"><TextBlock Text="{Binding Kind}" /></Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource KcapTextBrush}" />
                                            <TextBlock Text="{Binding Context}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource KcapMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Age}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{StaticResource KcapFaintBrush}" />
                                        <Button Grid.Column="3" Classes="kcapChip" Command="{Binding ActCommand}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Action}" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="drvSection" Text="{Binding WorkItemsHeader}" />
                    <ItemsControl x:Name="DriverWorkItems" ItemsSource="{Binding WorkItems}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="drv:DriverWorkItemViewModel">
                                <Button Classes="drvRow" Command="{Binding #Root.((drv:DriverViewModel)DataContext).SelectCommand}"
                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource KcapTextBrush}" />
                                                <Border Classes="drvPill" IsVisible="{Binding HasWorkspace}">
                                                    <TextBlock Text="{Binding Workspace}" Foreground="{StaticResource KcapMutedBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Goal}" IsVisible="{Binding HasGoal}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource KcapMutedBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                                <ItemsControl ItemsSource="{Binding Parts}" VerticalAlignment="Center">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="drv:DriverPartViewModel">
                                                            <Border Classes="drvCell" Classes.done="{Binding IsDone}" Classes.progress="{Binding IsInProgress}"
                                                                    Classes.review="{Binding IsInReview}" Classes.blocked="{Binding IsBlocked}"
                                                                    ToolTip.Tip="{Binding Title}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding PartsSummary}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{StaticResource KcapMutedBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border Classes="drvPill wait" IsVisible="{Binding HasNeeds}" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding NeedsText}" />
                                            </Border>
                                            <Border Classes="drvPill work" IsVisible="{Binding IsWorking}" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding WorkingText}" />
                                            </Border>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource KcapFaintBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- One work item: its goal, then its parts, review first and done last. -->
                <StackPanel IsVisible="{Binding IsDetail}">
                    <Button x:Name="DriverBackButton" Classes="kcapGhost" Command="{Binding BackCommand}" HorizontalAlignment="Left"
                            Margin="0,12,0,0" AutomationProperties.Name="Back to all work items">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <views:AppIcon Kind="ArrowLeft" Size="14" />
                            <TextBlock Text="All work items" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <StackPanel DataContext="{Binding Selected}" x:DataType="drv:DriverWorkItemViewModel" Spacing="4" Margin="2,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource KcapTextBrush}" />
                            <Border Classes="drvPill" IsVisible="{Binding HasWorkspace}">
                                <TextBlock Text="{Binding Workspace}" Foreground="{StaticResource KcapMutedBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Goal}" IsVisible="{Binding HasGoal}" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{StaticResource KcapMutedBrush}" />
                        <TextBlock Text="{Binding PartsSummary}" FontSize="12" Foreground="{StaticResource KcapFaintBrush}" />

                        <TextBlock Classes="drvSection" Text="Parts" />
                        <TextBlock Text="This work item has no parts yet." IsVisible="{Binding !HasParts}" FontSize="12"
                                   Foreground="{StaticResource KcapMutedBrush}" />
                        <ItemsControl x:Name="DriverParts" ItemsSource="{Binding Parts}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="drv:DriverPartViewModel">
                                    <Border Classes="drvCard">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                                            <Border Classes="drvCell" Classes.done="{Binding IsDone}" Classes.progress="{Binding IsInProgress}"
                                                    Classes.review="{Binding IsInReview}" Classes.blocked="{Binding IsBlocked}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource KcapTextBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding WaitsOnText}" FontSize="12" Foreground="{StaticResource KcapMutedBrush}" />
                                                    <TextBlock Text="{Binding Links}" FontSize="12" Foreground="{StaticResource KcapMutedBrush}" />
                                                    <TextBlock Text="{Binding SessionsText}" FontSize="12" Foreground="{StaticResource KcapFaintBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{StaticResource KcapMutedBrush}" />
                                            <Border Grid.Column="3" Classes="drvPill" Classes.wait="{Binding IsWaiting}" Classes.work="{Binding IsWorking}"
                                                    IsVisible="{Binding HasActivity}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Classes="drvDot" Classes.wait="{Binding IsWaiting}" Classes.work="{Binding IsWorking}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding ActivityLabel}" />
                                                </StackPanel>
                                            </Border>
                                            <Button Grid.Column="4" Classes="kcapChip" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}"
                                                    VerticalAlignment="Center" AutomationProperties.Name="Open the agent on this part">
                                                <TextBlock Text="Open" FontSize="12" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <!-- The chatbox: a starter composer until the first message starts the driver agent, then that agent's own chat. -->
    <Border Grid.Column="1" Width="440" IsVisible="{Binding HasChat}" BorderThickness="1,0,0,0"
            BorderBrush="{StaticResource KcapBorderBrush}" Background="{StaticResource KcapSurfaceBrush}">
        <Grid DataContext="{Binding Chat}" x:DataType="drv:DriverChatViewModel" RowDefinitions="Auto,*">
            <DockPanel Grid.Row="0" Margin="16,22,12,10">
                <Button x:Name="DriverNewChatButton" DockPanel.Dock="Right" Classes="kcapGhost" Command="{Binding NewConversationCommand}"
                        IsVisible="{Binding HasConversation}" AutomationProperties.Name="New Driver conversation">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <views:AppIcon Kind="Plus" Size="14" />
                        <TextBlock Text="New" FontSize="12" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <views:AppIcon Kind="MessageCircle" Size="14" Foreground="{StaticResource KcapTextBrush}" />
                    <TextBlock Text="Talk to Driver" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource KcapTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="16,4,16,16" Spacing="10" IsVisible="{Binding ShowsStarter}">
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource KcapMutedBrush}"
                           Text="Ask about your work items, or tell Driver what to do. It starts an agent that sees what Driver shows; anything it would change, it asks you first." />
                <TextBox x:Name="DriverChatDraft" Classes="kcapField" Text="{Binding Draft}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="90" Watermark="Why is wave 3 not moving?" AutomationProperties.Name="Message to Driver" />
                <DockPanel>
                    <Button x:Name="DriverChatSend" DockPanel.Dock="Right" Classes="kcapChip" Command="{Binding SendCommand}"
                            AutomationProperties.Name="Send to Driver">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <views:AppIcon Kind="ArrowUp" Size="14" />
                            <TextBlock Text="Send" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Starting Driver's agent…" IsVisible="{Binding IsStarting}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource KcapMutedBrush}" />
                </DockPanel>
                <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource KcapDangerBrush}" />
            </StackPanel>

            <views:ChatTabView Grid.Row="1" x:Name="DriverChatHost" DataContext="{Binding Conversation.Chat}"
                               IsVisible="{Binding $parent[Grid].((drv:DriverChatViewModel)DataContext).HasConversation}" />
        </Grid>
    </Border>
    </Grid>
</UserControl>
