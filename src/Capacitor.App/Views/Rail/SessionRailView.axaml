<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             xmlns:rail="clr-namespace:Capacitor.App.Views.Rail"
             xmlns:pages="clr-namespace:Capacitor.App.ViewModels.Pages"
             xmlns:svc="clr-namespace:Capacitor.App.Services"
             xmlns:cmd="clr-namespace:Capacitor.Cli.Core.Commands;assembly=Capacitor.Cli.Core"
             x:Class="Capacitor.App.Views.Rail.SessionRailView"
             x:DataType="vm:MainWindowViewModel">
    <!-- DataContext is INHERITED from the window (never assigned here), so Rail is null on any
         window built without one — every Rail.* binding below carries a fallback for that. -->
    <UserControl.Styles>
        <!-- A row's resting Background and BorderThickness MUST come from this class style, never a
             local attribute on the Button: a local value outranks a style trigger, which would leave
             the highlight styles below permanently inert (and suppress the theme's hover/pressed
             feedback). Avalonia has no CSS specificity, so the highlights are declared AFTER this
             base to win the tie. -->
        <Style Selector="Button.railRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <!-- A negative BetweenShowDelay makes every row wait the full ShowDelay; Avalonia's
                 default opens the next row's tip instantly while the pointer sweeps the rail. -->
            <Setter Property="ToolTip.ShowDelay" Value="1500" />
            <Setter Property="ToolTip.BetweenShowDelay" Value="-1" />
        </Style>
        <Style Selector="Border.railGroup">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.railGroup.workItem">
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="Border.railGroup.dropOver, Border#RailDropOut.dropOver">
            <Setter Property="Background" Value="{StaticResource KcapRowActiveBrush}" />
        </Style>
        <Style Selector="Border#RailDropOut.dropOver TextBlock">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Border#RailDropOut.dropOver Rectangle">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.railRow.lifted">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Border.railGroup.workItem Button#RailWorkItemHeader">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.2" Easing="0.4,0,0.2,1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.railGroup.workItem.expanded Button#RailWorkItemHeader">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="Button#RailWorkItemHeader views|FoldChevron.headerCaret">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button#RailWorkItemHeader:pointerover views|FoldChevron.headerCaret">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button#RailWorkItemToggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button#RailWorkItemToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button#RailWorkItemToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.rowTitle">
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="Button.railRow.selected TextBlock.rowTitle">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.railRow.unread TextBlock.rowTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="TextBlock.railMeta">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.railGroupLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <!-- The open row reads as selected by its background alone. A heavier title reflows the row,
             and a left accent insets its content past its siblings. -->
        <Style Selector="Button.selected">
            <Setter Property="Background" Value="{StaticResource KcapRowActiveBrush}" />
        </Style>
        <Style Selector="Button.railMenuRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.railMenuRow:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Button.railMenuRow views|AppIcon">
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.railMenuValue">
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Button.railPickerRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button#RailFilterButton">
            <Setter Property="ToolTip.Tip" Value="Session list settings · Default list settings" />
            <Setter Property="AutomationProperties.HelpText" Value="Default list settings. Adjust scope, state, grouping, or sorting." />
        </Style>
        <Style Selector="Button#RailFilterButton:flyout-open /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
        </Style>
        <Style Selector="Button#RailFilterButton.custom">
            <Setter Property="ToolTip.Tip" Value="Session list settings · Custom list settings applied" />
            <Setter Property="AutomationProperties.HelpText" Value="Custom list settings applied: scope, state, grouping, or sorting differs from the defaults." />
        </Style>
        <!-- The alert reads as a status line that leads to the launcher: no fill at rest or on hover
             (the footer grid clips anything wider), an underline and a brighter chevron instead. -->
        <Style Selector="Button.railAlertLink">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.railAlertLink:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.railAlertLink:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.railAlertLink views|AppIcon">
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
        </Style>
        <Style Selector="Button.railAlertLink:pointerover views|AppIcon, Button.railAlertLink:focus-visible views|AppIcon">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.railAlertLink:pointerover TextBlock#RailAlertText, Button.railAlertLink:focus-visible TextBlock#RailAlertText">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="Button#RailFilterButton views|AppIcon">
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="Button#RailFilterButton.custom views|AppIcon">
            <Setter Property="Foreground" Value="{StaticResource KcapInfoBrush}" />
        </Style>
        <!-- New session, Search and the pages read as one list: icon, label, and the shortcut only on hover or focus. -->
        <Style Selector="Button.railNav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0,0,9,0" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="Button.railNav views|AppIcon">
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.railNav TextBlock.navLabel">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.railNav TextBlock.navShortcut">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.railNav:pointerover TextBlock.navShortcut, Button.railNav:focus-visible TextBlock.navShortcut">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.footerValue">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.footerMeta">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
        </Style>
        <!-- U+00B7 sits at mid x-height by design, so the glyph centres itself against the
             fragments it separates. It is enlarged by a render transform rather than a FontSize,
             which would give it a taller line box than the row and drop its baseline below the
             fragments'; the transform is laid out at 11 and scaled about the box centre, so the
             glyph grows in place. -->
        <Style Selector="TextBlock.footerDot">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource KcapFaintBrush}" />
            <Setter Property="Text" Value="·" />
            <Setter Property="RenderTransform" Value="scale(1.5)" />
        </Style>
        <Style Selector="Button.railRow:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.railRow:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         Button.railRow.menuOpen /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapRowHoverBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <Style Selector="Button.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.selected:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         Button.selected.menuOpen /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapRowActiveBrush}" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
        </Style>
        <!-- Marked rows, the ones the row menu acts on together, read as a selection over the open row. -->
        <Style Selector="Button.railRow.marked">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
        </Style>
        <Style Selector="Button.railRow.marked:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.railRow.marked:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         Button.railRow.marked.menuOpen /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
        </Style>
    </UserControl.Styles>

    <Panel>
    <Border Background="{StaticResource KcapSurfaceBrush}"
            BorderThickness="0,0,1,0" BorderBrush="{StaticResource KcapBorderBrush}">
        <DockPanel Margin="0">
            <StackPanel DockPanel.Dock="Top">
                <!-- 44px chrome row, under the macOS traffic lights and the window's own controls
                     (the window extends the client area into the title bar). It drags the window —
                     wired in code-behind. -->
                <Grid Height="44" Background="Transparent" PointerPressed="OnChromePointerPressed" />
            </StackPanel>

            <!-- The footer always states the connection: Connected while healthy, the alert otherwise.
                 Settings › About holds each component's status and version. -->
            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{StaticResource KcapBorderBrush}">
                <StackPanel x:Name="RailFooterPanel" Margin="16,10,16,10" Spacing="2">
                    <!-- A daemon launchd holds in the background band throttles every hosted agent; the
                         block offers the reload and keeps its last outcome readable until a success clears it. -->
                    <Border x:Name="RailPriorityBlock" Classes="backgroundPriority" Margin="0,0,0,8" Padding="10,8"
                            CornerRadius="6" Background="{StaticResource KcapWarningDimBrush}"
                            IsVisible="{Binding ShowsReloadBlock}">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="RailPriorityText" Text="{Binding BackgroundPriorityText}" TextWrapping="Wrap"
                                       FontSize="12" LineHeight="17" Foreground="{StaticResource KcapWarningBrush}"
                                       IsVisible="{Binding BackgroundPriority}" />
                            <Button x:Name="RailReloadButton" Classes="kcapGhost" Content="Reload" Padding="10,4" FontSize="12.5"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ReloadDaemonCommand}" />
                            <TextBlock x:Name="RailReloadFailureText" Text="{Binding ReloadFailureText}" TextWrapping="Wrap"
                                       FontSize="12" LineHeight="17" Foreground="{StaticResource KcapWarningBrush}"
                                       IsVisible="{Binding ReloadFailureText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                    <!-- The chip docks beside the column, on its last line. -->
                    <Grid ColumnDefinitions="*,Auto" ClipToBounds="True">
                    <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Spacing="2" IsVisible="{Binding !ShowsUpdateContext}">
                    <!-- One status slot above the org: the alert when something needs the user,
                         Connected otherwise. The words are the indicator; the hover carries what the
                         one line leaves out. The repairing actions live in the launcher's banner, so
                         the alert opens the launcher rather than carrying a button of its own. -->
                    <StackPanel x:Name="RailAlertRow"
                                IsVisible="{Binding Alert, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Button x:Name="RailAlertLink" Classes="kcapGhost railAlertLink" HorizontalAlignment="Left"
                                Command="{Binding OpenRailAlertCommand}"
                                AutomationProperties.Name="{Binding Alert.Text, StringFormat='{}{0}: open the launcher', FallbackValue={x:Null}}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="RailAlertText" Text="{Binding Alert.Text, FallbackValue={x:Null}}" Classes="footerValue"
                                           Foreground="{Binding StatusBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           ToolTip.Tip="{Binding Alert.Detail, FallbackValue={x:Null}}" />
                                <views:AppIcon Kind="ChevronRight" Size="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="RailConnectedText" Text="{x:Static vm:MainWindowViewModel.ConnectedText}"
                               Classes="footerValue" Foreground="{StaticResource KcapSuccessBrush}"
                               IsVisible="{Binding ShowsConnected}" />
                    <TextBlock x:Name="RailTenantText" Text="{Binding FooterIdentity}" Classes="footerValue"
                               Foreground="{StaticResource KcapFaintBrush}" TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding FooterIdentity, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ToolTip.Tip>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding FooterServerUrl}" />
                                <TextBlock Text="{x:Static vm:MainWindowViewModel.ServerUrlTip}"
                                           Classes="kcapTipCaption" />
                            </StackPanel>
                        </ToolTip.Tip>
                    </TextBlock>
                    </StackPanel>
                    <StackPanel x:Name="RailUpdateContext" Grid.Column="0" VerticalAlignment="Center" Spacing="4"
                                IsVisible="{Binding ShowsUpdateContext}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <views:AppIcon Kind="Monitor" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding UpdateContextName}" Classes="footerValue"
                                       Foreground="{StaticResource KcapTextBrush}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5">
                            <TextBlock Text="This machine" Classes="footerMeta" />
                            <TextBlock Grid.Column="1" Classes="footerDot" IsVisible="{Binding DaemonName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Grid.Column="2" Text="{Binding DaemonName}" Classes="footerMeta" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                    <Button x:Name="RailHelpButton" Grid.Column="1" Classes="kcapChip" VerticalAlignment="Bottom"
                            Width="22" Height="22" Padding="0" CornerRadius="6" Margin="10,0,0,0"
                            ToolTip.Tip="Help and support" AutomationProperties.Name="Help and support">
                        <views:AppIcon Kind="CircleQuestionMark" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                        <Button.Flyout>
                                <!-- Same kcapPanel + ghost rows as the launcher pickers; MenuFlyout
                                     keeps Fluent MenuItem chrome (grey hover bar on this surface). -->
                                <Flyout Placement="TopEdgeAlignedRight" VerticalOffset="6"
                                        FlyoutPresenterClasses="kcapPanel">
                                    <StackPanel Spacing="2" Margin="6" MinWidth="188">
                                        <Button x:Name="RailOpenDashboardButton" Classes="kcapGhost"
                                                Command="{Binding Web.OpenCommand}" Click="OnHelpFlyoutItemClick"
                                                IsVisible="{Binding Web.IsVisible, FallbackValue=False}"
                                                ToolTip.Tip="{Binding Web.Tooltip}" AutomationProperties.Name="{Binding Web.Label}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" FontSize="13.5">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <TextBlock Text="{Binding Web.Label}" VerticalAlignment="Center" />
                                                <views:AppIcon Kind="ExternalLink" Size="14" />
                                            </StackPanel>
                                        </Button>
                                        <Border Height="1" Margin="8,4" Background="{StaticResource KcapBorderBrush}"
                                                IsVisible="{Binding Web.IsVisible, FallbackValue=False}" />
                                        <Button x:Name="RailHelpDocsButton" Classes="kcapGhost" Content="Documentation"
                                                Command="{Binding OpenDocsCommand}" Click="OnHelpFlyoutItemClick"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" FontSize="13.5" />
                                        <Button x:Name="RailHelpBugButton" Classes="kcapGhost" Content="Report a bug…"
                                                Command="{Binding OpenFeedbackCommand}" CommandParameter="{x:Static cmd:FeedbackCategory.Bug}"
                                                Click="OnHelpFlyoutItemClick"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" FontSize="13.5" />
                                        <Button x:Name="RailHelpFeedbackButton" Classes="kcapGhost" Content="Send feedback…"
                                                Command="{Binding OpenFeedbackCommand}" CommandParameter="{x:Static cmd:FeedbackCategory.Feedback}"
                                                Click="OnHelpFlyoutItemClick"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" FontSize="13.5" />
                                        <Border Height="1" Margin="8,4" Background="{StaticResource KcapBorderBrush}">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                    <Binding Path="CanOpenSetup" />
                                                    <Binding Path="SignInVisible" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                        </Border>
                                        <Button x:Name="RailHelpSetupButton" Classes="kcapGhost" Content="Set up kcap…"
                                                Command="{Binding SetupCommand}" Click="OnHelpFlyoutItemClick"
                                                IsVisible="{Binding CanOpenSetup}" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left" Padding="10,8" FontSize="13.5" />
                                        <Button x:Name="RailHelpSignInButton" Classes="kcapGhost" Content="Sign in"
                                                Command="{Binding SignInCommand}" Click="OnHelpFlyoutItemClick"
                                                IsVisible="{Binding SignInVisible}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" FontSize="13.5"
                                                AutomationProperties.Name="Sign in" />
                                        <Button x:Name="LocalSearchSettingsMenuButton" Classes="kcapGhost" Content="Search settings…"
                                                IsVisible="{Binding LocalStack.Search.ShowsInlineSettings, FallbackValue=False}"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="10,8" FontSize="13.5">
                                            <Button.Flyout>
                                                <Flyout Placement="RightEdgeAlignedBottom" HorizontalOffset="6" FlyoutPresenterClasses="kcapPanel">
                                                    <ScrollViewer MaxHeight="560" Width="440" Margin="16" VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <views:SearchSettingsView DataContext="{Binding LocalStack.Search}" />
                                                    </ScrollViewer>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <StackPanel x:Name="RailAppMenuItems" Spacing="2" IsVisible="{Binding AppMenuInWindow}">
                                            <Border Height="1" Margin="8,4" Background="{StaticResource KcapBorderBrush}" />
                                            <Button x:Name="RailHelpAboutButton" Classes="kcapGhost" Content="About kcap"
                                                    Click="OnAboutClick" IsVisible="{Binding ShowsAbout}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <Button x:Name="RailHelpCheckForUpdatesButton" Classes="kcapGhost" Content="Check for Updates…"
                                                    Command="{Binding CheckForUpdatesCommand}" Click="OnHelpFlyoutItemClick"
                                                    IsVisible="{Binding ShowsCheckForUpdates}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <Button x:Name="RailLaunchApprovalsButton" Classes="kcapGhost" Content="Launch approvals…"
                                                    Command="{Binding OpenLaunchApprovalsCommand}" Click="OnHelpFlyoutItemClick"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <Button x:Name="RailHelpSettingsButton" Classes="kcapGhost" Content="Settings…"
                                                    Command="{Binding OpenSettingsCommand}" Click="OnHelpFlyoutItemClick"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <Button x:Name="RailHelpUninstallButton" Classes="kcapGhost" Content="Uninstall kcap…"
                                                    Command="{Binding UninstallCommand}" Click="OnHelpFlyoutItemClick"
                                                    IsVisible="{Binding ShowsUninstall}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <Button x:Name="RailHelpChangelogButton" Classes="kcapGhost" Content="Changelog"
                                                    Command="{Binding OpenChangelogCommand}" Click="OnHelpFlyoutItemClick"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="10,8" FontSize="13.5" />
                                            <TextBlock x:Name="RailAppVersionText" Text="{Binding AppVersionLabel}"
                                                       Foreground="{StaticResource KcapFaintBrush}" FontSize="12" Margin="10,6,10,4" />
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5,0,5,8">
                <StackPanel>
                    <Button x:Name="RailProjectButton" Classes="kcapGhost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Margin="0,0,0,8" Padding="0,5,9,5" CornerRadius="7"
                            DataContext="{Binding Rail}" x:DataType="vm:SessionRailViewModel"
                            IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}"
                            AutomationProperties.Name="{Binding ProjectLabel, StringFormat='Project: {0}'}">
                        <Grid ColumnDefinitions="30,*,Auto">
                            <Border Width="20" Height="20" CornerRadius="5" HorizontalAlignment="Center" Background="{StaticResource KcapSurfaceRaisedBrush}"
                                    BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="1">
                                <Panel>
                                    <TextBlock x:Name="RailProjectInitial" Text="{Binding ProjectInitial}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource KcapTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding !IsAllProjects}" />
                                    <views:AppIcon Kind="Layers" Size="12" Foreground="{StaticResource KcapMutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsAllProjects}" />
                                </Panel>
                            </Border>
                            <TextBlock x:Name="RailProjectLabel" Grid.Column="1" Text="{Binding ProjectLabel}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource KcapTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <views:AppIcon Grid.Column="2" Kind="ChevronDown" Size="12" Foreground="{StaticResource KcapMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft" VerticalOffset="4" FlyoutPresenterClasses="kcapPanel">
                                <StackPanel Spacing="2" Margin="6" MinWidth="200">
                                    <ItemsControl x:Name="RailProjectList" ItemsSource="{Binding ProjectOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RailProjectOption">
                                                <Button Classes="kcapGhost railPickerRow" Click="OnProjectPickerItemClick"
                                                        Command="{Binding $parent[ItemsControl].((vm:SessionRailViewModel)DataContext).SetProjectCommand}"
                                                        CommandParameter="{Binding Project}" AutomationProperties.Name="{Binding Project.Name}">
                                                    <Grid ColumnDefinitions="16,*" ColumnSpacing="6">
                                                        <views:AppIcon Kind="Check" Size="12" IsVisible="{Binding IsCurrent}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Project.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Height="1" Background="{StaticResource KcapBorderBrush}" Margin="4,3" IsVisible="{Binding HasProjects}" />
                                    <Button x:Name="RailAllProjectsButton" Classes="kcapGhost railPickerRow" Click="OnProjectPickerItemClick"
                                            Command="{Binding SetProjectCommand}" CommandParameter="{x:Null}"
                                            AutomationProperties.Name="{x:Static vm:SessionRailViewModel.AllProjectsLabel}">
                                        <Grid ColumnDefinitions="16,*" ColumnSpacing="6">
                                            <views:AppIcon Kind="Check" Size="12" IsVisible="{Binding IsAllProjects}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Static vm:SessionRailViewModel.AllProjectsLabel}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <StackPanel x:Name="RailNav" Margin="0,0,0,10" Spacing="1">
                        <!-- Deselects the workspace (the pane's empty state IS the launcher), or nudges the launcher already showing. -->
                        <rail:RailNavRow x:Name="RailNewSessionButton" Icon="Plus" Label="New session"
                                         Shortcut="{x:Static views:ShortcutLabels.NewSession}" Command="{Binding NewSessionCommand}" />
                        <rail:RailNavRow x:Name="RailSearchButton" Icon="Search" Label="Search" AutomationProperties.Name="Search sessions"
                                         Shortcut="{x:Static views:ShortcutLabels.Search}" Command="{Binding OpenSearchCommand}" />
                        <rail:RailNavRow x:Name="RailSessionsPageButton" Icon="MessagesSquare" Label="Sessions" IsVisible="{Binding OffersPages}"
                                         Command="{Binding OpenPageCommand}" CommandParameter="{x:Static pages:PageKey.Sessions}"
                                         Classes.selected="{Binding Page.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static pages:PageKey.Sessions}}" />
                        <rail:RailNavRow x:Name="RailWorkItemsPageButton" Icon="Folder" Label="Work items"
                                         Command="{Binding OpenPageCommand}" CommandParameter="{x:Static pages:PageKey.WorkItems}"
                                         Classes.selected="{Binding Page.Key, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static pages:PageKey.WorkItems}}">
                            <rail:RailNavRow.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="OffersPages" />
                                    <Binding Path="Rail.OffersWorkItem" FallbackValue="False" />
                                </MultiBinding>
                            </rail:RailNavRow.IsVisible>
                        </rail:RailNavRow>
                    </StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Margin="11,4,5,2">
                        <TextBlock x:Name="RailRecentHeading" Text="Recent sessions" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource KcapMutedBrush}" VerticalAlignment="Center" />
                        <Button x:Name="RailFilterButton" Grid.Column="1" Classes="kcapGhost kcapIcon"
                                DataContext="{Binding Rail}" x:DataType="vm:SessionRailViewModel"
                                Classes.custom="{Binding FiltersDiffer}"
                                IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}"
                                AutomationProperties.Name="Session list settings">
                            <views:AppIcon Kind="ListFilter" Size="14" />
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft" VerticalOffset="4" FlyoutPresenterClasses="kcapPanel">
                                    <StackPanel x:Name="RailControls" Margin="6" Spacing="2" Width="260">
                                    <TextBlock Text="Properties" FontSize="12" Foreground="{StaticResource KcapFaintBrush}" Margin="10,4,10,4" />
                                    <Button x:Name="RailSortButton" Classes="kcapGhost railMenuRow" AutomationProperties.Name="Sort">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <views:AppIcon Kind="ArrowUpDown" Size="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Sort" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="railMenuValue" Text="{Binding SortLabel}" />
                                            <views:AppIcon Grid.Column="3" Kind="ChevronRight" Size="14" VerticalAlignment="Center" />
                                        </Grid>
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedTop" HorizontalOffset="6" FlyoutPresenterClasses="kcapPanel">
                                                <StackPanel Spacing="2" Margin="6" MinWidth="160">
                                                    <Button Classes="kcapGhost railPickerRow" Click="OnSortPickerItemClick"
                                                            Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:RailSort.LastUpdated}" Content="Last updated" />
                                                    <Button Classes="kcapGhost railPickerRow" Click="OnSortPickerItemClick"
                                                            Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:RailSort.Created}" Content="Created" />
                                                    <Button Classes="kcapGhost railPickerRow" Click="OnSortPickerItemClick"
                                                            Command="{Binding SetSortCommand}" CommandParameter="{x:Static vm:RailSort.Title}" Content="Title" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button x:Name="RailDirectionButton" Classes="kcapGhost railMenuRow" AutomationProperties.Name="Order" Command="{Binding ToggleDirectionCommand}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <Panel>
                                                <views:AppIcon Kind="ArrowDownWideNarrow" Size="14" IsVisible="{Binding Descending}" />
                                                <views:AppIcon Kind="ArrowUpNarrowWide" Size="14" IsVisible="{Binding !Descending}" />
                                            </Panel>
                                            <TextBlock Grid.Column="1" Text="Order" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="railMenuValue" Text="{Binding DirectionLabel}" />
                                        </Grid>
                                    </Button>
                                    <Button x:Name="RailGroupButton" Classes="kcapGhost railMenuRow" AutomationProperties.Name="Group">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <views:AppIcon Kind="LayoutGrid" Size="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Group" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="railMenuValue" Text="{Binding GroupingLabel}" />
                                            <views:AppIcon Grid.Column="3" Kind="ChevronRight" Size="14" VerticalAlignment="Center" />
                                        </Grid>
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedTop" HorizontalOffset="6" FlyoutPresenterClasses="kcapPanel">
                                                <StackPanel Spacing="2" Margin="6" MinWidth="160">
                                                    <Button x:Name="RailGroupWorkItemButton" Classes="kcapGhost railPickerRow" Click="OnGroupPickerItemClick" IsVisible="{Binding OffersWorkItem}"
                                                            Command="{Binding SetGroupingCommand}" CommandParameter="{x:Static vm:RailGrouping.WorkItem}" Content="Work item" />
                                                    <Button Classes="kcapGhost railPickerRow" Click="OnGroupPickerItemClick"
                                                            Command="{Binding SetGroupingCommand}" CommandParameter="{x:Static vm:RailGrouping.None}" Content="No grouping" />
                                                    <Button Classes="kcapGhost railPickerRow" Click="OnGroupPickerItemClick"
                                                            Command="{Binding SetGroupingCommand}" CommandParameter="{x:Static vm:RailGrouping.Repository}" Content="Repository" />
                                                    <Button Classes="kcapGhost railPickerRow" Click="OnGroupPickerItemClick"
                                                            Command="{Binding SetGroupingCommand}" CommandParameter="{x:Static vm:RailGrouping.Date}" Content="Date" />
                                                    <Button Classes="kcapGhost railPickerRow" Click="OnGroupPickerItemClick"
                                                            Command="{Binding SetGroupingCommand}" CommandParameter="{x:Static vm:RailGrouping.Status}" Content="Status" />
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button x:Name="RailScopeButton" Classes="kcapGhost railMenuRow" AutomationProperties.Name="Sessions" IsEnabled="{Binding CanChangeScope}" ToolTip.Tip="{Binding ScopeTip}" ToolTip.ShowOnDisabled="True">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <views:AppIcon Kind="Users" Size="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Sessions" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="railMenuValue" Text="{Binding Scope}" />
                                            <views:AppIcon Grid.Column="3" Kind="ChevronRight" Size="14" VerticalAlignment="Center" />
                                        </Grid>
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedTop" HorizontalOffset="6" FlyoutPresenterClasses="kcapPanel">
                                                <StackPanel Spacing="2" Margin="6" MinWidth="160">
                                                    <Button x:Name="RailScopeMineButton" Classes="kcapGhost railPickerRow" HorizontalContentAlignment="Stretch" Click="OnScopePickerItemClick"
                                                            Command="{Binding SetScopeCommand}" CommandParameter="{x:Static svc:RailScope.Mine}">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <TextBlock Text="Mine" />
                                                            <views:AppIcon Grid.Column="1" Kind="Check" Size="14" IsVisible="{Binding IsMine}" />
                                                        </Grid>
                                                    </Button>
                                                    <Button x:Name="RailScopeTeamButton" Classes="kcapGhost railPickerRow" HorizontalContentAlignment="Stretch" Click="OnScopePickerItemClick"
                                                            Command="{Binding SetScopeCommand}" CommandParameter="{x:Static svc:RailScope.Team}">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <TextBlock Text="Team" />
                                                            <views:AppIcon Grid.Column="1" Kind="Check" Size="14" IsVisible="{Binding IsTeam}" />
                                                        </Grid>
                                                    </Button>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button x:Name="RailStateButton" Classes="kcapGhost railMenuRow" AutomationProperties.Name="Status">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                            <views:AppIcon Kind="CircleDot" Size="14" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="Status" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="railMenuValue" Text="{Binding State}" />
                                            <views:AppIcon Grid.Column="3" Kind="ChevronRight" Size="14" VerticalAlignment="Center" />
                                        </Grid>
                                        <Button.Flyout>
                                            <Flyout Placement="RightEdgeAlignedTop" HorizontalOffset="6" FlyoutPresenterClasses="kcapPanel">
                                                <StackPanel Spacing="2" Margin="6" MinWidth="160">
                                                    <Button x:Name="RailStateAllButton" Classes="kcapGhost railPickerRow" HorizontalContentAlignment="Stretch" Click="OnStatePickerItemClick"
                                                            Command="{Binding SetStateCommand}" CommandParameter="{x:Static vm:RailState.All}">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <TextBlock Text="All" />
                                                            <views:AppIcon Grid.Column="1" Kind="Check" Size="14" IsVisible="{Binding IsAll}" />
                                                        </Grid>
                                                    </Button>
                                                    <Button x:Name="RailStateLiveButton" Classes="kcapGhost railPickerRow" HorizontalContentAlignment="Stretch" Click="OnStatePickerItemClick"
                                                            Command="{Binding SetStateCommand}" CommandParameter="{x:Static vm:RailState.Live}">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <TextBlock Text="Live" />
                                                            <views:AppIcon Grid.Column="1" Kind="Check" Size="14" IsVisible="{Binding IsLive}" />
                                                        </Grid>
                                                    </Button>
                                                    <Button x:Name="RailStateEndedButton" Classes="kcapGhost railPickerRow" HorizontalContentAlignment="Stretch" Click="OnStatePickerItemClick"
                                                            Command="{Binding SetStateCommand}" CommandParameter="{x:Static vm:RailState.Ended}">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                            <TextBlock Text="Ended" />
                                                            <views:AppIcon Grid.Column="1" Kind="Check" Size="14" IsVisible="{Binding IsEnded}" />
                                                        </Grid>
                                                    </Button>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Separator Margin="4,4" IsVisible="{Binding HasRemoved}" />
                                    <Button x:Name="RailRestoreRemovedButton" Classes="kcapGhost railMenuRow"
                                            Command="{Binding RestoreRemovedCommand}" IsVisible="{Binding HasRemoved}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <views:AppIcon Kind="Eye" Size="14" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding RestoreRemovedText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <TextBlock Text="Loading sessions…" FontSize="12" Foreground="{StaticResource KcapFaintBrush}"
                               Margin="11,0,11,8" IsVisible="{Binding LoadingSessions}" />
                    <TextBlock Text="No sessions" Foreground="{StaticResource KcapFaintBrush}" Margin="8,16"
                               IsVisible="{Binding ShowsNoSessions}" />
                    <ItemsControl x:Name="RailGroups" ItemsSource="{Binding Rail.Groups, FallbackValue={x:Null}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RailGroupViewModel">
                                <Border Classes="railGroup" Classes.workItem="{Binding IsWorkItem}" Classes.expanded="{Binding IsExpanded}">
                                    <StackPanel>
                                        <Button x:Name="RailWorkItemHeader" Classes="railRow" Classes.selected="{Binding IsSelected}" IsVisible="{Binding IsWorkItem}"
                                                Command="{Binding $parent[rail:SessionRailView].((vm:MainWindowViewModel)DataContext).OpenWorkItemCommand, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding WorkItemId}" Click="OnWorkItemHeaderClick"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                                Padding="0" ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding Label}">
                                            <Grid ColumnDefinitions="30,*,Auto">
                                                <!-- The toggle fills the row behind the title, so the chevron and the space after it
                                                     toggle; the title's full-height strip takes its clicks for the header. -->
                                                <Button x:Name="RailWorkItemToggle" Grid.Column="1" Grid.ColumnSpan="2" Command="{Binding ToggleCommand}"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                        AutomationProperties.Name="{Binding ToggleAccessibleName}" />
                                                <DockPanel Grid.Column="1" HorizontalAlignment="Left" Margin="0,0,10,0">
                                                    <views:FoldChevron DockPanel.Dock="Right" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                       Classes="chevron headerCaret" IsOpen="{Binding IsExpanded}" />
                                                    <Panel Background="Transparent">
                                                        <TextBlock x:Name="RailWorkItemTitle" FontSize="14" Foreground="{StaticResource KcapMutedBrush}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                            <Run Text="{Binding Label}" />
                                                            <Run Text="{Binding SessionCount}" Foreground="{StaticResource KcapFaintBrush}" />
                                                        </TextBlock>
                                                    </Panel>
                                                </DockPanel>
                                                <views:AppIcon x:Name="RailWorkItemDone" Grid.Column="2" Kind="Check" Size="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                                               IsVisible="{Binding IsDone}" Foreground="{StaticResource KcapSuccessBrush}" />
                                                <views:AppIcon Kind="Folder" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                                            </Grid>
                                        </Button>
                                        <Button Classes="sectionHeader expandable railRepoHeader" Command="{Binding ToggleCommand}" IsVisible="{Binding ShowsHeader}"
                                                Margin="0" Padding="9,0" ToolTip.Tip="{Binding Tooltip}" AutomationProperties.Name="{Binding ToggleAccessibleName}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <!-- A group named by its folder must not read as a repository. -->
                                                    <views:AppIcon Kind="Folder" Size="12" Margin="0,0,6,0" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource KcapMutedBrush}" IsVisible="{Binding IsFolder}" />
                                                    <TextBlock x:Name="RailRepoHeaderLabel" Grid.Column="1" Text="{Binding Label}" Classes="railGroupLabel"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </Grid>
                                                <views:FoldChevron Grid.Column="1" Size="12" Classes="chevron" IsOpen="{Binding IsExpanded}" />
                                            </Grid>
                                        </Button>
                                        <views:FoldPanel IsOpen="{Binding IsExpanded}">
                                        <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Sessions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:RailSessionViewModel">
                                                    <Border Margin="0,0,0,4"
                                                            Opacity="{Binding IsStale, Converter={x:Static views:StaleOpacityConverter.Instance}}">
                                                        <Button Command="{Binding OpenCommand}" HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Stretch" Padding="9,4" AttachedToVisualTree="OnSessionRowAttached"
                                                                AutomationProperties.Name="{Binding Primary}"
                                                                Classes="railRow" Classes.selected="{Binding IsSelected}" Classes.marked="{Binding IsMarked}" Classes.unread="{Binding IsUnread}">
                                                            <ToolTip.Tip>
                                                                <StackPanel Spacing="10" MaxWidth="320">
                                                                    <!-- The row trims its title; the tip carries it whole. -->
                                                                    <TextBlock x:Name="SessionTitleTip" Text="{Binding Primary}" TextWrapping="Wrap"
                                                                               IsVisible="{Binding HasTitle}" />
                                                                    <views:AgentStatusTip DataContext="{Binding Status}" />
                                                                    <StackPanel Spacing="1" IsVisible="{Binding MachineBadge, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                                        <TextBlock Text="{Binding MachineBadge}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="Machine · remote daemon" Classes="kcapTipCaption" />
                                                                    </StackPanel>
                                                                    <StackPanel Spacing="1" IsVisible="{Binding CheckoutPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                        <TextBlock Text="{Binding CheckoutPath}" TextWrapping="Wrap" />
                                                                        <TextBlock Text="Checkout" Classes="kcapTipCaption" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </ToolTip.Tip>
                                                            <Grid ColumnDefinitions="20,*,Auto">
                                                                <views:SessionStatusSlot Height="20" DataContext="{Binding Status}" />
                                                                <StackPanel Grid.Column="1" Spacing="1">
                                                                    <TextBlock Text="{Binding Primary}" FontSize="14" Classes="rowTitle"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                                        <Border Classes="vendorMark" Width="12" Height="12"
                                                                                VerticalAlignment="Center" Background="Transparent" IsVisible="{Binding HasVendor}"
                                                                                AutomationProperties.Name="{Binding Vendor, Converter={x:Static views:VendorLabelConverter.Instance}}"
                                                                                AutomationProperties.AccessibilityView="Content">
                                                                            <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"
                                                                                            Content="{Binding Vendor, Converter={x:Static views:VendorGlyphConverter.Instance}, ConverterParameter=12}" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource KcapMutedBrush}"
                                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="8,2,0,0" VerticalAlignment="Top">
                                                                    <views:OwnerAvatar VerticalAlignment="Center" Initials="{Binding OwnerInitials}" Url="{Binding OwnerAvatarUrl}"
                                                                                       IsVisible="{Binding ShowsOwner}" ToolTip.Tip="{Binding OwnerTooltip}"
                                                                                       AutomationProperties.Name="{Binding OwnerName}" AutomationProperties.AccessibilityView="Content" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button x:Name="RailWorkItemMore" Classes="kcapGhost kcapQuiet" HorizontalAlignment="Left" Padding="9,4" Margin="0,0,0,4"
                                                IsVisible="{Binding MoreText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Command="{Binding $parent[rail:SessionRailView].((vm:MainWindowViewModel)DataContext).OpenWorkItemCommand, FallbackValue={x:Null}}"
                                                CommandParameter="{Binding WorkItemId}">
                                            <TextBlock Text="{Binding MoreText}" />
                                        </Button>
                                        </StackPanel>
                                        </views:FoldPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="RailDropOut" IsVisible="False" Background="Transparent" CornerRadius="6" Margin="0,8,0,0" Padding="4">
                        <Panel Height="32">
                            <Rectangle Stroke="{StaticResource KcapBorderBrush}" StrokeThickness="1" StrokeDashArray="4,3" RadiusX="6" RadiusY="6" />
                            <TextBlock Text="Drop to take out of its work item" FontSize="12" Foreground="{StaticResource KcapMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                    </Border>
                    <StackPanel x:Name="RailPaging" DataContext="{Binding Rail}" x:DataType="vm:SessionRailViewModel"
                                Margin="0,4,0,6" Spacing="4" IsVisible="{Binding Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Button x:Name="RailViewAllButton" Classes="kcapGhost kcapQuiet" Content="View all sessions"
                                Command="{Binding $parent[rail:SessionRailView].((vm:MainWindowViewModel)DataContext).OpenPageCommand, FallbackValue={x:Null}}"
                                CommandParameter="{x:Static pages:PageKey.Sessions}"
                                IsVisible="{Binding ShowsViewAll}" HorizontalAlignment="Left" Padding="9,5" />
                        <TextBlock x:Name="RailLiveNotShownText" Text="{Binding LiveNotShownText}" Classes="railMeta"
                                   Foreground="{StaticResource KcapFaintBrush}" Margin="9,0" TextWrapping="Wrap"
                                   IsVisible="{Binding LiveNotShownText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
    <Canvas IsHitTestVisible="False">
        <Border x:Name="RailDragGhost" IsVisible="False" DataContext="{x:Null}" x:DataType="vm:RailSessionViewModel"
                Height="32" MaxWidth="220" Padding="12,0" CornerRadius="6" BorderThickness="1"
                Background="{StaticResource KcapSurfaceRaisedBrush}" BorderBrush="{StaticResource KcapBorderStrongBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ContentControl VerticalAlignment="Center"
                                Content="{Binding Vendor, FallbackValue={x:Null}, Converter={x:Static views:VendorGlyphConverter.Instance}, ConverterParameter=13}" />
                <TextBlock x:Name="RailDragGhostLabel" FontSize="13" FontWeight="Medium" Foreground="{StaticResource KcapTextBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Canvas>
    </Panel>
</UserControl>
