<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.Views.AllSessionsPageView"
             x:DataType="vm:AllSessionsPageViewModel">
    <UserControl.Styles>
        <Style Selector="Button.rowButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="-10,0" />
        </Style>
        <Style Selector="ComboBox.filter">
            <Setter Property="MinWidth" Value="140" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
    </UserControl.Styles>

    <Border Background="{StaticResource KcapCanvasBrush}">
        <DockPanel Margin="24,20,24,0" XYFocus.NavigationModes="Keyboard">
            <StackPanel DockPanel.Dock="Top" MaxWidth="860" Spacing="4" Margin="0,0,14,16">
                <TextBlock x:Name="AllSessionsHeading" Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="AllSessionsCount" Text="{Binding Count}" FontSize="12" Foreground="{StaticResource KcapMutedBrush}" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,12,0,0">
                    <TextBox x:Name="AllSessionsSearch" Classes="kcapField" Padding="10,7" MinHeight="34" FontSize="13"
                             PlaceholderText="Search sessions" Text="{Binding Search, Mode=TwoWay}"
                             AutomationProperties.Name="Search sessions" />
                    <ComboBox x:Name="AllSessionsWorkItem" Grid.Column="1" Classes="kcapField filter"
                              ItemsSource="{Binding WorkItems}" SelectedItem="{Binding WorkItem, Mode=TwoWay}"
                              AutomationProperties.Name="Work item">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AllSessionsChoice">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox x:Name="AllSessionsOwner" Grid.Column="2" Classes="kcapField filter"
                              ItemsSource="{Binding Owners}" SelectedItem="{Binding Owner, Mode=TwoWay}"
                              AutomationProperties.Name="Owner">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AllSessionsChoice">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </StackPanel>
            <ScrollViewer>
                <StackPanel MaxWidth="860" Spacing="8" Margin="0,0,14,24">
                    <ItemsControl x:Name="AllSessionsDays" ItemsSource="{Binding Days}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AllSessionsDay">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Medium"
                                               Foreground="{StaticResource KcapMutedBrush}" Margin="0,12,0,6" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:AllSessionsRow">
                                                <Button Classes="kcapGhost rowButton"
                                                        Command="{Binding $parent[views:AllSessionsPageView].((vm:AllSessionsPageViewModel)DataContext).OpenSessionCommand}"
                                                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                                    <Grid ColumnDefinitions="20,*,Auto">
                                                        <Panel Height="18" VerticalAlignment="Top" HorizontalAlignment="Left">
                                                            <views:AgentStatusMark DataContext="{Binding Status}" VerticalAlignment="Center" />
                                                            <Ellipse Width="4" Height="4" Margin="4,0,0,0" Fill="{StaticResource KcapFaintBrush}" VerticalAlignment="Center"
                                                                     IsVisible="{Binding !Status.HasGlyph}" />
                                                        </Panel>
                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <ContentControl Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding HasVendor}"
                                                                                AutomationProperties.Name="{Binding Vendor, Converter={x:Static views:VendorLabelConverter.Instance}}"
                                                                                Content="{Binding Vendor, Converter={x:Static views:VendorGlyphConverter.Instance}, ConverterParameter=12}" />
                                                                <TextBlock Text="{Binding Meta}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                                           Foreground="{StaticResource KcapMutedBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="8,1,0,0">
                                                            <!-- Another user's row shows their picture, or their initials until it loads or when it never does. -->
                                                            <Border Width="16" Height="16" CornerRadius="8" VerticalAlignment="Center" ClipToBounds="True"
                                                                    Background="{StaticResource KcapSurfaceRaisedBrush}" BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="1"
                                                                    IsVisible="{Binding ShowsOwner}" ToolTip.Tip="{Binding OwnerName}"
                                                                    AutomationProperties.Name="{Binding OwnerName}">
                                                                <Panel>
                                                                    <TextBlock Text="{Binding OwnerInitials}" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource KcapMutedBrush}" />
                                                                    <views:RemoteAvatar Url="{Binding OwnerAvatarUrl}" />
                                                                </Panel>
                                                            </Border>
                                                            <TextBlock Text="{Binding Age}" FontSize="11.5" VerticalAlignment="Center"
                                                                       Foreground="{StaticResource KcapFaintBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="AllSessionsMessage" Text="{Binding Message}" FontSize="13"
                               Foreground="{StaticResource KcapMutedBrush}"
                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Button x:Name="AllSessionsShowMore" Classes="kcapGhost kcapQuiet" Content="Show more" Command="{Binding ShowMoreCommand}"
                            IsVisible="{Binding CanShowMore}" HorizontalAlignment="Left" Padding="9,5" Margin="-9,0" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
