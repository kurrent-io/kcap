<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             x:Class="Capacitor.App.Views.KcapTooltip" x:DataType="vm:KcapTip" MaxWidth="320">
    <UserControl.Styles>
        <Style Selector="TextBlock.tipState"><Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" /></Style>
        <Style Selector="TextBlock.tipState.danger"><Setter Property="Foreground" Value="{StaticResource KcapDangerBrush}" /></Style>
        <Style Selector="TextBlock.tipState.active"><Setter Property="Foreground" Value="{StaticResource KcapPurpleBrush}" /></Style>
    </UserControl.Styles>
    <StackPanel Spacing="5">
        <StackPanel Spacing="1">
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"
                       FontSize="{StaticResource KcapFontSizeBody}" Foreground="{StaticResource KcapTextBrush}" />
            <TextBlock Text="{Binding State}" TextWrapping="Wrap" Classes="tipState" FontWeight="SemiBold"
                       Classes.danger="{Binding IsDanger}" Classes.active="{Binding IsActive}"
                       IsVisible="{Binding State, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Details}" IsVisible="{Binding HasDetails}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="{StaticResource KcapFontSizeSmall}"
                               Foreground="{StaticResource KcapMutedBrush}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel IsVisible="{Binding Action, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <views:AppIcon DockPanel.Dock="Left" Kind="ArrowRight" Size="12" Margin="0,0,5,0" VerticalAlignment="Center"
                           Foreground="{StaticResource KcapInfoBrush}" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="{Binding Action}" TextWrapping="Wrap" FontWeight="Medium"
                       Foreground="{StaticResource KcapInfoBrush}" />
        </DockPanel>
    </StackPanel>
</UserControl>
