<rxui:ReactiveWindow xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:rxui="clr-namespace:ReactiveUI.Avalonia;assembly=ReactiveUI.Avalonia"
                     xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
                     xmlns:views="clr-namespace:Capacitor.App.Views"
                     xmlns:svc="clr-namespace:Capacitor.App.Services"
                     xmlns:onboarding="clr-namespace:Capacitor.App.Views.Onboarding"
                     x:Class="Capacitor.App.Views.MainWindow"
                     x:TypeArguments="vm:MainWindowViewModel"
                     x:DataType="vm:MainWindowViewModel"
                     Title=""
                     Icon="avares://kcap-desktop/Assets/kcap-icon.png"
                     Width="{x:Static svc:WindowSizeMemory.DefaultWidth}"
                     MinWidth="{x:Static svc:WindowSizeMemory.MinWidth}"
                     Height="{x:Static svc:WindowSizeMemory.DefaultHeight}"
                     MinHeight="{x:Static svc:WindowSizeMemory.MinHeight}"
                     Background="{StaticResource KcapCanvasBrush}"
                     ExtendClientAreaToDecorationsHint="True">
    <Window.KeyBindings>
        <KeyBinding Gesture="Meta+N" Command="{Binding NewSessionCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewSessionCommand}" />
    </Window.KeyBindings>
    <!-- Rail | launcher-or-workspace. The right pane's empty state IS the launcher.
         Workspace content is a template so the terminal is only built once a session opens.
         ExtendClientAreaToDecorationsHint paints into the title bar; the transparent strip below
         only receives presses where no surface content is hit-testable — rail and workspace
         headers carry their own drag handlers. -->
    <Panel>
        <!-- Outside the scale, so the drag strip stays the title bar's height at any zoom. -->
        <Border Height="40" VerticalAlignment="Top" Background="Transparent"
                PointerPressed="OnChromePointerPressed" />

        <LayoutTransformControl x:Name="ScaleHost">
            <Panel>
                <Grid x:Name="SessionsSurface">
                    <!-- The rail column is sized from Panes in code-behind. -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <views:SessionRailView x:Name="SessionRail" Grid.Column="0" />
                    <Panel x:Name="ContentPane" Grid.Column="1">
                        <!-- Hidden, never removed, under the search cover: the workspace and its watches carry on. -->
                        <Grid x:Name="LauncherPane" RowDefinitions="Auto,*" Margin="24,20,24,24">
                            <Grid.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="CurrentWorkspace" Converter="{x:Static ObjectConverters.IsNull}" />
                                    <Binding Path="!IsSearchOpen" />
                                </MultiBinding>
                            </Grid.IsVisible>
                            <Grid x:Name="LauncherHeader" Grid.Row="0" ColumnDefinitions="*,Auto" Background="Transparent"
                                  PointerPressed="OnChromePointerPressed">
                                <!-- Daemon recovery sits in LauncherPaneView's connection banner (same
                                     place as sign-in), not here in the chrome. -->

                                <Button Grid.Column="1" x:Name="OpenWebButton" Classes="kcapChip" VerticalAlignment="Top"
                                        HorizontalAlignment="Right" Command="{Binding Web.OpenCommand}"
                                        IsVisible="{Binding Web.IsVisible, FallbackValue=False}"
                                        ToolTip.Tip="{Binding Web.Tooltip}"
                                        AutomationProperties.Name="{Binding Web.Label}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="{Binding Web.Label}" VerticalAlignment="Center" />
                                        <views:AppIcon Kind="ExternalLink" Size="14" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <views:LauncherPaneView x:Name="LauncherView" Grid.Row="1" DataContext="{Binding Home}" HistoryImport="{Binding $parent[views:MainWindow].((vm:MainWindowViewModel)DataContext).HistoryImportBanner}" />
                        </Grid>

                        <ContentControl x:Name="WorkspaceHost" Content="{Binding CurrentWorkspace}">
                            <ContentControl.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="CurrentWorkspace" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                    <Binding Path="!IsSearchOpen" />
                                </MultiBinding>
                            </ContentControl.IsVisible>
                            <ContentControl.DataTemplates>
                                <views:RetainedViewTemplate x:DataType="vm:WorkspaceViewModel">
                                    <views:WorkspaceView />
                                </views:RetainedViewTemplate>
                                <views:RetainedViewTemplate x:DataType="vm:RemoteSessionViewModel">
                                    <views:RemoteSessionView />
                                </views:RetainedViewTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>

                        <views:SessionSearchView x:Name="SearchCover" IsVisible="{Binding IsSearchOpen}" />

                        <Border x:Name="SwitchCover" Background="{StaticResource KcapCanvasBrush}" IsVisible="False">
                            <views:StillImage x:Name="SwitchCoverStill" />
                        </Border>
                    </Panel>
                    <!-- Last child so it hit-tests above the content pane it overhangs. -->
                    <GridSplitter x:Name="RailSplitter" Grid.Column="0" HorizontalAlignment="Right" Width="6"
                                  Margin="0,0,-3,0" Background="Transparent" ResizeDirection="Columns"
                                  DragDelta="OnRailSplitterDragDelta" DragCompleted="OnRailSplitterDragCompleted" />
                </Grid>

                <!-- Window controls that never move: over the rail's chrome row while it shows, over
                     the content's top-left corner once it collapses to nothing, where each header
                     pads clear of them through RailClearance. -->
                <StackPanel x:Name="WindowControls" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Panel>
                        <Button x:Name="RailToggleButton" Classes="kcapGhost kcapIcon" Click="OnRailToggleClick">
                            <views:AppIcon x:Name="RailToggleIcon" Size="16" Foreground="{StaticResource KcapMutedBrush}" />
                        </Button>
                        <!-- Beside the button, not inside it: the button clips its content. The count is
                             pinned by its left edge just past the icon's chevron, so a wider one grows into
                             the gap before Back rather than across the icon. The canvas ring cuts the mark
                             out of the icon's strokes. -->
                        <Panel x:Name="RailAttentionMark" IsVisible="False" IsHitTestVisible="False"
                               HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Ellipse Width="10" Height="10" Margin="1,1,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Fill="{Binding RailAttentionBrush}"
                                     Stroke="{StaticResource KcapCanvasBrush}" StrokeThickness="2"
                                     IsVisible="{Binding !RailAttention.HasSessionCount}" />
                            <Border CornerRadius="7" Padding="1.5" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Background="{StaticResource KcapCanvasBrush}"
                                    IsVisible="{Binding RailAttention.HasSessionCount}">
                                <Border MinWidth="11" Height="11" CornerRadius="5.5" Padding="2.5,0"
                                        Background="{Binding RailAttentionBrush}">
                                    <TextBlock Text="{Binding RailAttention.CountText}" FontSize="9" FontWeight="Bold" LineHeight="11"
                                               Foreground="{StaticResource KcapOnPrimaryBrush}"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </Border>
                        </Panel>
                    </Panel>
                    <Button x:Name="BackButton" Classes="kcapGhost kcapIcon" Command="{Binding GoBackCommand}"
                            ToolTip.Tip="{x:Static views:ShortcutLabels.BackTip}" AutomationProperties.Name="Back">
                        <views:AppIcon Kind="ArrowLeft" Size="16" Foreground="{StaticResource KcapMutedBrush}" />
                    </Button>
                    <Button x:Name="ForwardButton" Classes="kcapGhost kcapIcon" Command="{Binding GoForwardCommand}"
                            ToolTip.Tip="{x:Static views:ShortcutLabels.ForwardTip}" AutomationProperties.Name="Forward">
                        <views:AppIcon Kind="ArrowRight" Size="16" Foreground="{StaticResource KcapMutedBrush}" />
                    </Button>
                </StackPanel>
            </Panel>
        </LayoutTransformControl>

        <!-- Unscaled like the strip above: the pane draws its own title-bar drag area. -->
        <!-- Onboarding covers the rail and launcher until it hands over; see Onboarding. -->
        <onboarding:OnboardingPaneView x:Name="OnboardingPane" DataContext="{x:Null}" IsVisible="False" />

        <TextBlock x:Name="InstanceTitle" IsVisible="False" IsHitTestVisible="False"
                   Height="40" VerticalAlignment="Top" HorizontalAlignment="Center"
                   Padding="0,12,0,0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   MaxWidth="480" Foreground="{StaticResource KcapMutedBrush}" />
    </Panel>
</rxui:ReactiveWindow>
