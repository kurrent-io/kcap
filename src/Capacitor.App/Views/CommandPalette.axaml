<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Capacitor.App.Views.CommandPalette"
             KeyboardNavigation.TabNavigation="Cycle">
    <UserControl.Styles>
        <Style Selector="Button.paletteResult.highlighted /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource KcapSelectionBrush}" />
        </Style>
    </UserControl.Styles>
    <Panel>
        <Border x:Name="Backdrop" Background="{DynamicResource KcapCanvasBrush}" Opacity="0.62" PointerPressed="OnBackdropPressed" />
        <Border VerticalAlignment="Top" MaxWidth="570" MaxHeight="460" Margin="24,44,24,20" Padding="14"
                Background="{DynamicResource KcapSurfaceRaisedBrush}" BorderBrush="{DynamicResource KcapBorderStrongBrush}"
                BorderThickness="1" CornerRadius="12" AutomationProperties.Name="Command palette"
                AutomationProperties.LandmarkType="Form">
            <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox x:Name="Query" Classes="kcapField" PlaceholderText="Search commands…"
                             AutomationProperties.Name="Search commands" TextChanged="OnQueryChanged" />
                    <Button Grid.Column="1" Classes="kcapGhost" Content="Close" ToolTip.Tip="Escape"
                            AutomationProperties.Name="Close command palette" Click="OnCloseClick" />
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Results" Spacing="2" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyResults" Grid.Row="1" Text="No matching commands" Margin="8,10"
                           FontSize="{DynamicResource KcapFontSizeBody}" Foreground="{DynamicResource KcapMutedBrush}" />
            </Grid>
        </Border>
    </Panel>
</UserControl>
