<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Capacitor.App.Views">
    <Style Selector="views|ChatMessageRow.messageRow:not(:inline-chrome) views|MessageCopyButton,
                     views|ChatMessageRow:not(:inline-chrome) Border.userTurn views|MessageCopyButton">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="views|ChatMessageRow.messageRow:not(:inline-chrome):pointerover views|MessageCopyButton,
                     views|ChatMessageRow:not(:inline-chrome) Border.userTurn:pointerover views|MessageCopyButton,
                     views|ChatMessageRow:not(:inline-chrome) views|MessageCopyButton:focus-within">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="views|ChatMessageRow Border.userTurn">
        <Setter Property="Padding" Value="{DynamicResource KcapUserTurnPadding}" />
        <Setter Property="MaxWidth" Value="520" />
    </Style>
    <Style Selector="views|ChatMessageRow.messageRow:not(:inline-chrome) DockPanel.messageLayout">
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="views|ChatMessageHeader">
        <Setter Property="DockPanel.Dock" Value="Top" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="views|ChatMessageRow.userRow TextBlock.messageAuthor">
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="views|ChatMessageRow:not(:inline-chrome) TextBlock.messageTime" x:DataType="TextBlock">
        <Setter Property="ToolTip.Tip" Value="{Binding $parent[views:ChatMessageRow].Timestamp.Tip}" />
    </Style>
</Styles>
