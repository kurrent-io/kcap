<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Capacitor.App.Views.Pages">
    <Styles.Resources>
        <!-- The arrow keys move between the search box and the rows. -->
        <ControlTheme x:Key="{x:Type local:ListPage}" TargetType="local:ListPage">
            <Setter Property="Background" Value="{StaticResource KcapCanvasBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <!-- The session and work item pages' frame: a bordered header bar, then their *,6*,* body column. -->
                        <DockPanel XYFocus.NavigationModes="Keyboard">
                            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="0,0,0,1"
                                    Padding="20,16,16,16">
                                <StackPanel Spacing="6">
                                    <TextBlock Name="PART_Heading" Text="{TemplateBinding Heading}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource KcapTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{TemplateBinding Count}" FontSize="13" Foreground="{StaticResource KcapMutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,6*,*" Margin="0,16,0,8">
                                <DockPanel Grid.Column="1">
                                    <ContentPresenter DockPanel.Dock="Right" Margin="8,0,0,0" Content="{TemplateBinding Filters}"
                                                      IsVisible="{TemplateBinding Filters, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <TextBox Name="PART_Search" Classes="kcapField" Padding="10,7" MinHeight="34" FontSize="13"
                                             PlaceholderText="{TemplateBinding SearchPlaceholder}" Text="{TemplateBinding Search, Mode=TwoWay}"
                                             AutomationProperties.Name="{TemplateBinding SearchPlaceholder}" />
                                </DockPanel>
                            </Grid>
                            <ScrollViewer>
                                <Grid ColumnDefinitions="*,6*,*" Margin="0,8,0,24">
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        <TextBlock Name="PART_Message" Text="{TemplateBinding Message}" FontSize="13"
                                                   Foreground="{StaticResource KcapMutedBrush}"
                                                   IsVisible="{TemplateBinding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <ContentPresenter Content="{TemplateBinding Footer}" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- A list row: full width, its hover background reaching past the text on both sides. -->
    <Style Selector="local|ListPage Button.listRow">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="-10,0" />
    </Style>
</Styles>
