<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             xmlns:pages="clr-namespace:Capacitor.App.ViewModels.Pages"
             xmlns:local="clr-namespace:Capacitor.App.Views.Pages"
             x:Class="Capacitor.App.Views.Pages.WorkItemPageView" ClipToBounds="False"
             x:DataType="pages:WorkItemPageViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.bar">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.barAction">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.barAction /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="Button.inlineEdit">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="IBeam" />
        </Style>
        <Style Selector="Button.inlineEdit /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.inlineEdit:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.inlineEdit:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapRowHoverBrush}" />
        </Style>
        <Style Selector="TextBox.inlineEdit">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBox.inlineEdit /template/ Border#PART_BorderElement,
                         TextBox.inlineEdit:focus /template/ Border#PART_BorderElement,
                         TextBox.inlineEdit:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{StaticResource KcapRowHoverBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.groupHead">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.groupHead /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapRowHoverBrush}" />
        </Style>
        <Style Selector="Button.groupHead:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.groupHead:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapRowActiveBrush}" />
        </Style>
        <Style Selector="Button.partRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="4,0,10,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.partRow.expandable">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.partRow:not(.expandable) TextBlock.partTitle">
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="Button.partRow.expandable:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.partRow.expandable:pressed /template/ ContentPresenter#PART_ContentPresenter,
                         Button.partRow.menuOpen /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource KcapRowHoverBrush}" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="{StaticResource KcapRowHoverBrush}" />
        </Style>
        <Style Selector="Border.row Button.makePart">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.row:pointerover Button.makePart, Border.row:focus-within Button.makePart">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.rowButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Button.sessionRow">
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.menuRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.linkSum">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.linkSum /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource KcapMutedBrush}" />
        </Style>
        <Style Selector="Button.detailRow">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="-8,0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <!-- Without a background, a drag over the gaps between rows hit-tests through the zone and its outline flickers. -->
        <Style Selector="StackPanel.group, StackPanel.part">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="StackPanel.groupItems">
            <Setter Property="Spacing" Value="2" />
            <Setter Property="Margin" Value="22,2,0,0" />
        </Style>
        <Style Selector="Button.dragRow">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="0.4,0,0.2,1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.lifted">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Border.column">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="MinHeight" Value="160" />
            <Setter Property="Width" Value="280" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource KcapSurfaceRaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderStrongBrush}" />
        </Style>
        <Style Selector="Border.card TextBlock.sessionMeta">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.cardBody">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.cardBody /template/ ContentPresenter#PART_ContentPresenter,
                         Button.cardBody:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                         Button.cardBody:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.pill">
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource KcapMutedBrush}" />
            <Setter Property="TextElement.FontSize" Value="11.5" />
        </Style>
        <Style Selector="Button.linkSum.pillButton">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.kcapSegmentItem.boardSwitch">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.addSlice">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <!-- Geometry mirrors Button.partRow so the status glyph and title line up with the slices above. -->
        <Style Selector="Border.composerRow">
            <Setter Property="Padding" Value="3,0,6,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderBrush}" />
        </Style>
        <Style Selector="Border.composerRow:focus-within">
            <Setter Property="BorderBrush" Value="{StaticResource KcapBorderStrongBrush}" />
        </Style>
        <Style Selector="Border.column TextBlock.composerHint">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.composerStatus">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0,0,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.composer">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource KcapTextBrush}" />
            <Setter Property="PlaceholderForeground" Value="{StaticResource KcapFaintBrush}" />
        </Style>
        <Style Selector="TextBox.composer /template/ Border#PART_BorderElement,
                         TextBox.composer:focus /template/ Border#PART_BorderElement,
                         TextBox.composer:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Panel.groupHeadRow:pointerover Button.addSlice, Panel.groupHeadRow:focus-within Button.addSlice,
                         Border.column:pointerover Button.addSlice, Border.column:focus-within Button.addSlice">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.startSlice">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.partRow:pointerover Button.startSlice, Button.partRow:focus-within Button.startSlice">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.column.dropOver, StackPanel.part.dropOver > Border.card">
            <Setter Property="Background" Value="{StaticResource KcapSelectionBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource KcapInfoBrush}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="LinkRow" x:DataType="pages:WorkItemPageLink">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <views:AppIcon Kind="{Binding Icon}" Size="14" Foreground="{StaticResource KcapFaintBrush}"
                               IsVisible="{Binding !IsMerged}" />
                <views:AppIcon Kind="{Binding Icon}" Size="14" Foreground="{StaticResource KcapSuccessBrush}"
                               IsVisible="{Binding IsMerged}" />
                <TextBlock Grid.Column="1" Text="{Binding ShortKey}" MinWidth="64" Foreground="{StaticResource KcapMutedBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding StateLabel}" FontSize="12.5" Foreground="{StaticResource KcapMutedBrush}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LinkButton" x:DataType="pages:WorkItemPageLink">
            <Button Classes="kcapGhost rowButton" ToolTip.Tip="{Binding Title}" AutomationProperties.Name="{Binding ShortKey}"
                    Command="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).OpenLinkCommand}"
                    CommandParameter="{Binding}" Content="{Binding}" ContentTemplate="{StaticResource LinkRow}" Click="OnFlyoutItemClick" />
        </DataTemplate>

        <DataTemplate x:Key="SessionRow" x:DataType="pages:WorkItemPageSession">
            <Button Classes="kcapGhost rowButton sessionRow dragRow"
                    Command="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).OpenSessionCommand}"
                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" MinHeight="30">
                    <ContentControl Width="14" Height="14" VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Vendor, Converter={x:Static views:VendorLabelConverter.Instance}}"
                                    Content="{Binding Vendor, Converter={x:Static views:VendorGlyphConverter.Instance}, ConverterParameter=14}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" Foreground="{StaticResource KcapTextBrush}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="sessionMeta" Text="{Binding Meta}" FontSize="12"
                               Foreground="{StaticResource KcapFaintBrush}" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="WaitChoice" x:DataType="pages:WorkItemPageWaitChoice">
            <Button Classes="kcapGhost menuRow" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="7">
                    <views:AppIcon Kind="Check" Size="14" IsVisible="{Binding Waits}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="waits on this" FontSize="11" IsVisible="{Binding Loops}" VerticalAlignment="Center"
                               Foreground="{StaticResource KcapFaintBrush}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="WaitChoices" x:DataType="pages:WorkItemPageWaitPicker">
            <StackPanel Margin="6" Width="320">
                <TextBlock Text="Waits on" FontSize="11" Margin="10,4" Foreground="{StaticResource KcapMutedBrush}" />
                <TextBox Classes="kcapField" Margin="4,2,4,6" PlaceholderText="Search slices" AutomationProperties.Name="Search slices"
                         Text="{Binding Filter}" IsVisible="{Binding Searches}" AttachedToVisualTree="OnWaitSearchAttached" />
                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Shown}" ItemTemplate="{StaticResource WaitChoice}" />
                </ScrollViewer>
                <TextBlock Text="No slice matches" FontSize="12" Margin="10,6" Foreground="{StaticResource KcapFaintBrush}"
                           IsVisible="{Binding !Shown.Count}" />
            </StackPanel>
        </DataTemplate>

        <!-- Stays open while slices are ticked: the page holds its rebuilds until it closes. -->
        <Flyout x:Key="WaitPicker" FlyoutPresenterClasses="kcapPanel" Opened="OnWaitPickerOpened" Closed="OnWaitPickerClosed">
            <ContentControl x:DataType="pages:WorkItemPagePart" Content="{Binding WaitPicker}" ContentTemplate="{StaticResource WaitChoices}" />
        </Flyout>

        <DataTemplate x:Key="GraphBox" x:DataType="pages:WorkItemPagePart">
            <StackPanel Classes="part" Width="{x:Static pages:WorkItemPageGraphNode.Width}">
                <Border Classes="card" Height="{x:Static pages:WorkItemPageGraphNode.Height}">
                    <Button Classes="kcapGhost partRow dragRow cardBody" Classes.expandable="{Binding HasSessions}" Padding="10,0"
                            VerticalAlignment="Stretch" ToolTip.Tip="{Binding WaitsOnText}" AutomationProperties.Name="{Binding Title}"
                            Command="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).ShowInListCommand}"
                            CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                            <views:AppIcon Kind="{Binding Icon}" Size="14" VerticalAlignment="Center"
                                           Foreground="{Binding Status, Converter={x:Static views:WorkStatusBrushConverter.Instance}}" />
                            <TextBlock Grid.Column="1" Classes="partTitle" Text="{Binding Title}" FontSize="13" FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding GraphSub}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource KcapMutedBrush}" />
                        </Grid>
                    </Button>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Part" x:DataType="pages:WorkItemPagePart">
            <StackPanel Classes="part" AttachedToVisualTree="OnRowAttached">
                <Button Classes="kcapGhost partRow dragRow" Classes.expandable="{Binding HasSessions}"
                        Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Title}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,72,14" ColumnSpacing="4" MinHeight="34">
                        <views:AppIcon Kind="{Binding Icon}" Size="14" Margin="6,0,4,0" VerticalAlignment="Center"
                                       Foreground="{Binding Status, Converter={x:Static views:WorkStatusBrushConverter.Instance}}" />
                        <TextBlock Grid.Column="1" Classes="partTitle" Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="{StaticResource KcapWarningDimBrush}" CornerRadius="9" Padding="7,1"
                                VerticalAlignment="Center" IsVisible="{Binding NeedsYou}">
                            <TextBlock Text="Needs you" FontSize="12.5" Foreground="{StaticResource KcapWarningBrush}" />
                        </Border>
                        <Button Grid.Column="4" Classes="kcapGhost linkSum" IsVisible="{Binding HasLinks}" ToolTip.Tip="{Binding LinkTip}"
                                AutomationProperties.Name="{Binding LinkTip, StringFormat='Links: {0}'}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <views:AppIcon Kind="GitPullRequest" Size="12" IsVisible="{Binding HasPrs}" />
                                <TextBlock Text="{Binding PrSummary}" IsVisible="{Binding HasPrs}" Margin="0,0,4,0" />
                                <views:AppIcon Kind="CircleDot" Size="12" IsVisible="{Binding HasIssues}" />
                                <TextBlock Text="{Binding IssueSummary}" IsVisible="{Binding HasIssues}" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="kcapPanel">
                                    <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkButton}" Margin="6" MinWidth="340" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Grid.Column="3" Classes="kcapGhost linkSum" IsVisible="{Binding Waits}" ToolTip.Tip="{Binding WaitsOnText}"
                                Click="OnWaitsClick" AutomationProperties.Name="{Binding WaitsOnText}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <views:AppIcon Kind="Hourglass" Size="12" />
                                <TextBlock Text="{Binding WaitsOn.Count}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="5" Classes="kcapGhost kcapIcon startSlice"
                                Command="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).StartSliceSessionCommand}"
                                CommandParameter="{Binding}"
                                IsVisible="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).CanStartSession}"
                                ToolTip.Tip="Start a session on this slice" AutomationProperties.Name="{Binding Title, StringFormat='Start a session on {0}'}">
                            <views:AppIcon Kind="Play" Size="12" Foreground="{StaticResource KcapMutedBrush}" />
                        </Button>
                        <TextBlock Grid.Column="6" Text="{Binding SessionSummary}" FontSize="11" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource KcapMutedBrush}" IsVisible="{Binding HasSessions}" />
                        <views:FoldChevron Grid.Column="7" Size="12" Classes="chevron" IsOpen="{Binding IsExpanded}" VerticalAlignment="Center"
                                           Foreground="{StaticResource KcapMutedBrush}" IsVisible="{Binding HasSessions}" />
                    </Grid>
                </Button>
                <views:FoldPanel IsOpen="{Binding IsExpanded}">
                    <Border BorderThickness="1,0,0,0" BorderBrush="{StaticResource KcapBorderBrush}" Margin="17,0,0,4">
                        <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionRow}" Margin="4,0,0,0" />
                    </Border>
                </views:FoldPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Composer" x:DataType="pages:WorkItemPageGroupViewModel">
            <Border Classes="composerRow" IsVisible="{Binding IsComposing}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="3" MinHeight="32">
                <Button Classes="kcapGhost composerStatus" ToolTip.Tip="Change status"
                        AutomationProperties.Name="{Binding Label, StringFormat='Status: {0}'}">
                    <views:AppIcon Kind="{Binding Icon}" Size="14"
                                   Foreground="{Binding Status, Converter={x:Static views:WorkStatusBrushConverter.Instance}}" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="kcapPanel">
                            <ItemsControl ItemsSource="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).Statuses}"
                                          Margin="6" MinWidth="188">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:WorkItemPageStatus">
                                        <Button Classes="kcapGhost menuRow" AutomationProperties.Name="{Binding Label}" Click="OnComposerStatusClick">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <views:AppIcon Kind="{Binding Icon}" Size="14"
                                                               Foreground="{Binding Status, Converter={x:Static views:WorkStatusBrushConverter.Instance}}" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <TextBox Grid.Column="1" Classes="composer" MaxLength="200"
                         PlaceholderText="New slice title" AutomationProperties.Name="New slice title"
                         Text="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).NewPartTitle}"
                         AttachedToVisualTree="OnComposerAttached" LostFocus="OnComposerLostFocus" />
                <TextBlock Grid.Column="2" Classes="composerHint" Text="Enter to add · Esc to cancel" FontSize="11" Margin="6,0"
                           Foreground="{StaticResource KcapFaintBrush}" VerticalAlignment="Center" />
            </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AddSlice" x:DataType="pages:WorkItemPageGroupViewModel">
            <Button Classes="kcapGhost kcapIcon addSlice" ToolTip.Tip="Add slice"
                    AutomationProperties.Name="{Binding Label, StringFormat='Add slice to {0}'}"
                    Command="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).ComposeCommand}"
                    CommandParameter="{Binding Status}">
                <views:AppIcon Kind="Plus" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="Group" x:DataType="pages:WorkItemPageGroupViewModel">
            <StackPanel Classes="group">
                <Panel Classes="groupHeadRow">
                    <Button Classes="kcapGhost groupHead" Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Label}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <views:FoldChevron Size="14" Classes="chevron" IsOpen="{Binding IsExpanded}" />
                            <views:AppIcon Kind="{Binding Icon}" Size="14"
                                           Foreground="{Binding Status, Converter={x:Static views:WorkStatusBrushConverter.Instance}}" />
                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AddSlice}" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,4,0"
                                    IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </Panel>
                <views:FoldPanel IsOpen="{Binding IsExpanded}">
                    <StackPanel Classes="groupItems">
                        <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource Part}" />
                        <ItemsControl ItemsSource="{Binding LooseEnds}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pages:WorkItemPageLooseEnd">
                                    <Border Classes="row" Padding="10,4,6,4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding Text}" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="kcapChip makePart" Content="Make slice"
                                                    Command="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).MakePartCommand}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Text, StringFormat='Make {0} a slice'}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionRow}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Composer}" />
                    </StackPanel>
                </views:FoldPanel>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Card" x:DataType="pages:WorkItemPagePart">
            <StackPanel Classes="part" AttachedToVisualTree="OnRowAttached">
                <Border Classes="card">
                    <StackPanel>
                        <Button Classes="kcapGhost partRow dragRow cardBody" Classes.expandable="{Binding HasSessions}"
                                Command="{Binding ToggleCommand}" AutomationProperties.Name="{Binding Title}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <views:AppIcon Kind="{Binding Icon}" Size="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                                   Foreground="{Binding Status, Converter={x:Static views:WorkStatusBrushConverter.Instance}}" />
                                    <TextBlock Grid.Column="1" Classes="partTitle" Text="{Binding Title}" FontSize="13.5" FontWeight="Medium" LineHeight="18"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <WrapPanel ItemSpacing="6" LineSpacing="6">
                                    <Border Classes="pill" BorderBrush="{StaticResource KcapWarningDimBrush}"
                                            Background="{StaticResource KcapWarningDimBrush}" IsVisible="{Binding NeedsYou}">
                                        <TextBlock Text="Needs you" Foreground="{StaticResource KcapWarningBrush}" VerticalAlignment="Center" />
                                    </Border>
                                    <Button Classes="kcapGhost linkSum pillButton" IsVisible="{Binding HasLinks}" ToolTip.Tip="{Binding LinkTip}"
                                            AutomationProperties.Name="{Binding LinkTip, StringFormat='Links: {0}'}">
                                        <Border Classes="pill">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <views:AppIcon Kind="GitPullRequest" Size="12" IsVisible="{Binding HasPrs}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding PrSummary}" IsVisible="{Binding HasPrs}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                <views:AppIcon Kind="CircleDot" Size="12" IsVisible="{Binding HasIssues}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding IssueSummary}" IsVisible="{Binding HasIssues}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="kcapPanel">
                                                <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkButton}" Margin="6" MinWidth="340" />
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Classes="kcapGhost linkSum pillButton" IsVisible="{Binding Waits}" ToolTip.Tip="{Binding WaitsOnText}"
                                            Click="OnWaitsClick" AutomationProperties.Name="{Binding WaitsOnText}">
                                        <Border Classes="pill">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <views:AppIcon Kind="Hourglass" Size="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding WaitsOn.Count}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                    <Border Classes="pill" IsVisible="{Binding HasSessions}" ToolTip.Tip="{Binding SessionSummary}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <views:AppIcon Kind="MessagesSquare" Size="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Sessions.Count}" VerticalAlignment="Center" />
                                            <views:FoldChevron Size="11" Classes="chevron" IsOpen="{Binding IsExpanded}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Button>
                        <views:FoldPanel IsOpen="{Binding IsExpanded}">
                            <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource KcapBorderBrush}" Padding="2,4"
                                    IsVisible="{Binding HasSessions}">
                                <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionRow}" />
                            </Border>
                        </views:FoldPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SessionCard" x:DataType="pages:WorkItemPageSession">
            <Border Classes="card">
                <Button Classes="kcapGhost sessionRow dragRow cardBody"
                        Command="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).OpenSessionCommand}"
                        CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <ContentControl Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,0,0"
                                            AutomationProperties.Name="{Binding Vendor, Converter={x:Static views:VendorLabelConverter.Instance}}"
                                            Content="{Binding Vendor, Converter={x:Static views:VendorGlyphConverter.Instance}, ConverterParameter=14}" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" FontWeight="Medium" LineHeight="18"
                                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource KcapFaintBrush}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Meta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </Button>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Column" x:DataType="pages:WorkItemPageGroupViewModel">
            <Border Classes="group column">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,0,0,6" MinHeight="32">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <views:AppIcon Kind="{Binding Icon}" Size="14" VerticalAlignment="Center"
                                           Foreground="{Binding Status, Converter={x:Static views:WorkStatusBrushConverter.Instance}}" />
                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                        <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource AddSlice}" VerticalAlignment="Center"
                                        IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Grid>
                    <StackPanel Spacing="8">
                        <ItemsControl ItemsSource="{Binding Parts}" ItemTemplate="{StaticResource Card}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionCard}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding LooseEnds}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pages:WorkItemPageLooseEnd">
                                    <Border Classes="card" Padding="12,10">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{Binding Text}" FontSize="13.5" LineHeight="18" TextWrapping="Wrap" MaxLines="3"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Classes="kcapChip" Content="Make slice" HorizontalAlignment="Left"
                                                    Command="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).MakePartCommand}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Text, StringFormat='Make {0} a slice'}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource Composer}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="SplitGrid" ColumnDefinitions="*,320" Background="{StaticResource KcapCanvasBrush}">
        <DockPanel Grid.Column="0">
            <Border x:Name="WorkItemHeader" DockPanel.Dock="Top" BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="0,0,0,1"
                    Padding="20,16,16,16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="-6,0,8,0">
                        <Panel>
                            <Button x:Name="WorkItemTitle" Classes="inlineEdit" Command="{Binding TitleEditor.BeginEditCommand}"
                                    IsVisible="{Binding !TitleEditor.IsEditing}" ToolTip.Tip="{Binding Title}"
                                    AutomationProperties.Name="{Binding Title, StringFormat='Rename {0}'}">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource KcapTextBrush}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <views:InlineRenameBox x:Name="WorkItemTitleInput" Classes="inlineEdit" DataContext="{Binding TitleEditor}"
                                                   Text="{Binding Draft}" IsReadOnly="{Binding IsSaving}" IsVisible="{Binding IsEditing}"
                                                   MaxLength="120" FontSize="16" FontWeight="SemiBold" AutomationProperties.Name="Work item title" />
                        </Panel>
                        <Panel>
                            <Button x:Name="WorkItemGoal" Classes="inlineEdit" Command="{Binding GoalEditor.BeginEditCommand}"
                                    IsVisible="{Binding !GoalEditor.IsEditing}" ToolTip.Tip="{Binding Goal}" AutomationProperties.Name="Edit goal">
                                <Panel>
                                    <TextBlock Text="{Binding Goal}" FontSize="13" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource KcapMutedBrush}" />
                                    <TextBlock Text="Add a goal" FontSize="13" Foreground="{StaticResource KcapFaintBrush}"
                                               IsVisible="{Binding Goal, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                </Panel>
                            </Button>
                            <views:InlineRenameBox x:Name="WorkItemGoalInput" Classes="inlineEdit" DataContext="{Binding GoalEditor}"
                                                   Text="{Binding Draft}" IsReadOnly="{Binding IsSaving}" IsVisible="{Binding IsEditing}"
                                                   MaxLength="500" TextWrapping="Wrap" FontSize="13" PlaceholderText="Add a goal"
                                                   AutomationProperties.Name="Work item goal" />
                        </Panel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="WorkItemStartSession" Classes="kcapChip" Command="{Binding StartSessionCommand}"
                                IsVisible="{Binding CanStartSession}" ToolTip.Tip="Start a session on this work item"
                                AutomationProperties.Name="Start session">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <views:AppIcon Kind="Play" Size="12" />
                                <TextBlock Text="Start session" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="WorkItemOpenInWeb" Classes="kcapGhost kcapIcon" Command="{Binding OpenInWebCommand}"
                                ToolTip.Tip="Open in the web app" AutomationProperties.Name="Open in the web app">
                            <views:AppIcon Kind="ExternalLink" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                        </Button>
                        <Button x:Name="ContextShowButton" Classes="kcapGhost kcapIcon" IsVisible="False"
                                ToolTip.Tip="Show details" AutomationProperties.Name="Show details">
                            <views:AppIcon Kind="PanelRightOpen" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Panel>
                <DockPanel x:Name="WorkItemPageHost" IsVisible="{Binding PageViewer, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="0,0,0,1" Padding="16,6">
                        <Button x:Name="WorkItemPageBack" Classes="kcapGhost barAction" HorizontalAlignment="Left"
                                Command="{Binding ClosePageCommand}" AutomationProperties.Name="Back to slices">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <views:AppIcon Kind="ArrowLeft" Size="12" />
                                <TextBlock Text="Slices" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <ContentControl Content="{Binding PageViewer}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:PageViewerViewModel">
                                <views:PageViewer />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </DockPanel>
                <ScrollViewer IsVisible="{Binding PageViewer, Converter={x:Static ObjectConverters.IsNull}}">
                        <StackPanel Spacing="8" Margin="20,16,16,24">
                            <TextBlock x:Name="WorkItemMessage" Text="{Binding Message}" FontSize="12" Foreground="{StaticResource KcapMutedBrush}"
                                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Classes="bar" Text="Slices" />
                                <StackPanel x:Name="WorkItemProgress" Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding ProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            ToolTip.Tip="{Binding ProgressText, StringFormat='{}{0} slices done'}">
                                    <Panel Width="16" Height="16" VerticalAlignment="Center">
                                        <Ellipse Stroke="{StaticResource KcapBorderStrongBrush}" StrokeThickness="2.5" />
                                        <Arc StartAngle="-90" SweepAngle="{Binding ProgressSweep}" Stroke="{StaticResource KcapMutedBrush}"
                                             StrokeThickness="2.5" StrokeLineCap="Round" />
                                    </Panel>
                                    <TextBlock Text="{Binding ProgressText}" FontSize="15" Foreground="{StaticResource KcapMutedBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                    <Border Classes="kcapSegment" Padding="2">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button x:Name="WorkItemListButton" Classes="kcapSegmentItem boardSwitch" Content="List"
                                                    Classes.active="{Binding IsList}" Command="{Binding ShowListCommand}" />
                                            <Button x:Name="WorkItemBoardButton" Classes="kcapSegmentItem boardSwitch" Content="Board"
                                                    Classes.active="{Binding IsBoard}" Command="{Binding ShowBoardCommand}" />
                                            <Button x:Name="WorkItemGraphButton" Classes="kcapSegmentItem boardSwitch" Content="Graph"
                                                    Classes.active="{Binding IsGraph}" Command="{Binding ShowGraphCommand}" />
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="AddPartButton" Classes="kcapGhost kcapIcon" ToolTip.Tip="Add slice"
                                            AutomationProperties.Name="Add slice" Command="{Binding ComposeCommand}"
                                            CommandParameter="{x:Static vm:WorkStatus.Open}">
                                        <views:AppIcon Kind="Plus" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Panel x:Name="WorkItemSlices">
                                <ItemsControl x:Name="WorkItemGroups" ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource Group}"
                                              IsVisible="{Binding IsList}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <StackPanel x:Name="WorkItemGraphView" IsVisible="{Binding IsGraph}" Spacing="8">
                                    <TextBlock Text="Nothing waits on anything yet. Drag a slice onto the one it waits on." FontSize="12"
                                               Foreground="{StaticResource KcapMutedBrush}" IsVisible="{Binding !Graph.Nodes.Count}" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                  IsVisible="{Binding Graph.Nodes.Count}">
                                        <Panel Width="{Binding Graph.Width}" Height="{Binding Graph.Height}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <ItemsControl ItemsSource="{Binding Graph.Edges}" IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Panel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="pages:WorkItemPageGraphEdge">
                                                        <Panel>
                                                            <Path Data="{Binding Curve}" Stroke="{StaticResource KcapBorderStrongBrush}" StrokeThickness="1.5" />
                                                            <Path Data="{Binding Head}" Fill="{StaticResource KcapBorderStrongBrush}" />
                                                        </Panel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Graph.Nodes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.Styles>
                                                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="pages:WorkItemPageGraphNode">
                                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                                    </Style>
                                                </ItemsControl.Styles>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="pages:WorkItemPageGraphNode">
                                                        <ContentControl Content="{Binding Part}" ContentTemplate="{StaticResource GraphBox}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Panel>
                                    </ScrollViewer>
                                    <TextBlock Classes="bar" Text="{Binding Graph.Loose.Count, StringFormat='No dependencies · {0}'}" FontSize="13">
                                        <TextBlock.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="Graph.Nodes.Count" />
                                                <Binding Path="Graph.Loose.Count" />
                                            </MultiBinding>
                                        </TextBlock.IsVisible>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Graph.Loose}" ItemTemplate="{StaticResource GraphBox}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                                <ScrollViewer x:Name="WorkItemBoardView" IsVisible="{Binding IsBoard}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="WorkItemBoard" ItemsSource="{Binding Columns}" ItemTemplate="{StaticResource Column}"
                                                  Margin="0,0,0,12">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Panel>
                        </StackPanel>
                </ScrollViewer>
            </Panel>
        </DockPanel>

        <Border x:Name="DetailsPane" Grid.Column="1" BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16">
                    <Grid ColumnDefinitions="*,Auto" MinHeight="30">
                        <TextBlock Text="DETAILS" Classes="eyebrow" />
                        <Button x:Name="HideButton" Grid.Column="1" Classes="kcapGhost kcapIcon" IsVisible="False"
                                ToolTip.Tip="Hide details" AutomationProperties.Name="Hide details">
                            <views:AppIcon Kind="PanelRightClose" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                        </Button>
                    </Grid>

                    <StackPanel x:Name="ResourcesSection" Margin="0,16,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" MinHeight="28">
                            <TextBlock Text="RESOURCES" Classes="eyebrow" />
                            <TextBlock Grid.Column="1" Text="{Binding Links.Count}" Classes="sectionMeta"
                                       IsVisible="{Binding Links.Count, Converter={x:Static views:CountIsNotZeroConverter.Instance}}" />
                            <Button x:Name="AddLinkButton" Grid.Column="2" Classes="kcapGhost kcapIcon" ToolTip.Tip="Add link"
                                    AutomationProperties.Name="Add link">
                                <views:AppIcon Kind="Plus" Size="14" Foreground="{StaticResource KcapMutedBrush}" />
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="kcapPanel">
                                        <StackPanel Spacing="8" Margin="8" Width="260">
                                            <TextBox Classes="kcapField" Text="{Binding NewLinkReference}" PlaceholderText="Issue key or PR"
                                                     AutomationProperties.Name="Issue key or PR" />
                                            <Button Classes="kcapChip" Content="Add link" HorizontalAlignment="Right"
                                                    Command="{Binding AddLinkCommand}" Click="OnFlyoutItemClick" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <Border Margin="0,4,0,0" IsVisible="{Binding Links.Count, Converter={x:Static views:CountIsNotZeroConverter.Instance}}">
                            <ItemsControl x:Name="WorkItemLinks" ItemsSource="{Binding Links}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:WorkItemPageLink">
                                        <Button Classes="kcapGhost detailRow" ToolTip.Tip="{Binding Url}" AutomationProperties.Name="{Binding ShortKey}"
                                                Command="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).OpenLinkCommand}"
                                                CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Panel VerticalAlignment="Top" Margin="0,1,0,0">
                                                    <views:AppIcon Kind="{Binding Icon}" Size="14" Foreground="{StaticResource KcapFaintBrush}"
                                                                   IsVisible="{Binding !IsMerged}" />
                                                    <views:AppIcon Kind="{Binding Icon}" Size="14" Foreground="{StaticResource KcapSuccessBrush}"
                                                                   IsVisible="{Binding IsMerged}" />
                                                </Panel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" FontSize="13" LineHeight="16" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource KcapTextBrush}"
                                                               IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <TextBlock FontSize="12" Foreground="{StaticResource KcapMutedBrush}">
                                                        <Run Text="{Binding ShortKey}" />
                                                        <Run Text=" · " />
                                                        <Run Text="{Binding StateLabel}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PagesSection" Margin="0,18,0,0"
                                IsVisible="{Binding Pages.Count, Converter={x:Static views:CountIsNotZeroConverter.Instance}}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinHeight="28">
                            <TextBlock Text="PAGES" Classes="eyebrow" />
                            <TextBlock Grid.Column="1" Text="{Binding Pages.Count}" Classes="sectionMeta" />
                        </Grid>
                        <Border Margin="0,4,0,0">
                            <ItemsControl x:Name="WorkItemPages" ItemsSource="{Binding Pages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="pages:WorkItemPublishedPage">
                                        <Button Classes="kcapGhost detailRow" ToolTip.Tip="{Binding Url}" AutomationProperties.Name="{Binding Title}"
                                                Command="{Binding $parent[local:WorkItemPageView].((pages:WorkItemPageViewModel)DataContext).OpenPageCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontSize="13" LineHeight="16" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource KcapTextBrush}" />
                                                <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{StaticResource KcapMutedBrush}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Canvas x:Name="DragLayer" Grid.ColumnSpan="2" IsHitTestVisible="False">
            <Border x:Name="DropOutline" IsVisible="False" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource KcapInfoBrush}" />
            <!-- The snapshot sits in a Canvas so a row wider than the ghost is cut at its right, not centred. -->
            <Border x:Name="DragGhost" IsVisible="False" CornerRadius="6" BorderThickness="1" BoxShadow="0 10 28 0 #80000000" ClipToBounds="True"
                    Background="{StaticResource KcapSurfaceRaisedBrush}" BorderBrush="{StaticResource KcapBorderStrongBrush}">
                <Canvas>
                    <Image x:Name="DragGhostSnapshot" Stretch="None" />
                </Canvas>
            </Border>
        </Canvas>
        <!-- Last child so it hit-tests above the column it overhangs. -->
        <GridSplitter x:Name="ContextSplitter" Grid.Column="1" HorizontalAlignment="Left" Width="6"
                      Margin="-3,0,0,0" Background="Transparent" ResizeDirection="Columns" />
        <Border Grid.ColumnSpan="2" Background="#80000000"
                IsVisible="{Binding DropPrompt, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Border Width="400" Padding="20" CornerRadius="10" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 10 28 0 #80000000" Background="{StaticResource KcapSurfaceRaisedBrush}" BorderBrush="{StaticResource KcapBorderStrongBrush}">
                <StackPanel Spacing="18">
                    <TextBlock Text="{Binding DropPrompt}" TextWrapping="Wrap" FontSize="14" LineHeight="21"
                               Foreground="{StaticResource KcapTextBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Classes="kcapChip" Content="Cancel" Command="{Binding CancelDropCommand}" IsCancel="True" />
                        <Button Classes="kcapPrimary" Content="Move" Command="{Binding ConfirmDropCommand}" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
