<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             xmlns:pages="clr-namespace:Capacitor.App.ViewModels.Pages"
             x:Class="Capacitor.App.Views.Pages.SessionsPageRowView"
             x:DataType="pages:SessionsPageRow">
    <Grid ColumnDefinitions="20,*,Auto">
        <views:SessionStatusSlot Height="18" DataContext="{Binding Status}" />
        <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="5">
                <ContentControl Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding HasVendor}"
                                AutomationProperties.Name="{Binding Vendor, Converter={x:Static views:VendorLabelConverter.Instance}}"
                                Content="{Binding Vendor, Converter={x:Static views:VendorGlyphConverter.Instance}, ConverterParameter=12}" />
                <TextBlock Text="{Binding Meta}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Foreground="{StaticResource KcapMutedBrush}" />
            </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="8,1,0,0">
            <views:OwnerAvatar VerticalAlignment="Center" Initials="{Binding OwnerInitials}" Url="{Binding OwnerAvatarUrl}"
                               IsVisible="{Binding ShowsOwner}" ToolTip.Tip="{Binding OwnerName}" AutomationProperties.Name="{Binding OwnerName}" />
            <TextBlock Text="{Binding Age}" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource KcapFaintBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
