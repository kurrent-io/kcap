<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:Capacitor.App.ViewModels.Pages"
             xmlns:local="clr-namespace:Capacitor.App.Views.Pages"
             x:Class="Capacitor.App.Views.Pages.SessionsPageView"
             x:DataType="pages:SessionsPageViewModel">
    <local:ListPage x:Name="SessionsPage" Heading="{Binding Heading}" Count="{Binding Count}" Search="{Binding Search}"
                    SearchPlaceholder="Search sessions" Message="{Binding Message}">
        <local:ListPage.Filters>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <local:FilterPicker x:Name="SessionsWorkItem" Classes="kcapField filter" Choices="{Binding WorkItems}"
                          Selected="{Binding WorkItem, Mode=TwoWay}" SearchPlaceholder="Search work items" AutomationProperties.Name="Work item" />
                <local:FilterPicker x:Name="SessionsOwner" Classes="kcapField filter" Choices="{Binding Owners}"
                          Selected="{Binding Owner, Mode=TwoWay}" SearchPlaceholder="Search people" AutomationProperties.Name="Owner" />
            </StackPanel>
        </local:ListPage.Filters>
        <local:ListPage.Footer>
            <Button x:Name="SessionsShowMore" Classes="kcapGhost kcapQuiet" Content="Show more" Command="{Binding ShowMoreCommand}"
                    IsVisible="{Binding CanShowMore}" HorizontalAlignment="Left" Padding="9,5" Margin="-9,0" />
        </local:ListPage.Footer>
        <ItemsControl x:Name="SessionsPageDays" ItemsSource="{Binding Days}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="pages:SessionsPageDay">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Medium"
                                   Foreground="{StaticResource KcapMutedBrush}" Margin="0,12,0,6" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="pages:SessionsPageRow">
                                    <Button Classes="kcapGhost listRow" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}"
                                            Command="{Binding $parent[local:SessionsPageView].((pages:SessionsPageViewModel)DataContext).OpenSessionCommand}">
                                        <local:SessionsPageRowView />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </local:ListPage>
</UserControl>
