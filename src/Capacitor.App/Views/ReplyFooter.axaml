<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             x:Class="Capacitor.App.Views.ReplyFooter"
             x:DataType="vm:ChatItemViewModel"
             Classes.revealed="{Binding Reply.IsActive, FallbackValue=False}">
    <views:ReplyFooter.Metadata>
        <MultiBinding StringFormat="{}{0} · {1}">
            <Binding Path="$parent[ItemsControl].((vm:ChatTabViewModel)DataContext).AssistantTitle" />
            <Binding Path="Reply.Time.Tip" />
        </MultiBinding>
    </views:ReplyFooter.Metadata>
    <!-- Copy keeps the outer edge, then the marks of the reply's first message, then the time. -->
    <StackPanel Orientation="Horizontal" Spacing="2">
        <views:MessageCopyButton Text="{Binding Reply.Text}" AutomationProperties.HelpText="{Binding $parent[views:ReplyFooter].Metadata}" />
        <views:MessageMarks DataContext="{Binding Reply.First}" />
        <TextBlock Classes="chatTime messageTime" Text="{Binding Reply.Time.Label}"
                   ToolTip.Tip="{Binding $parent[views:ReplyFooter].Metadata}"
                   AutomationProperties.HelpText="{Binding $parent[views:ReplyFooter].Metadata}"
                   IsVisible="{Binding Reply.Time, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </StackPanel>
</UserControl>
