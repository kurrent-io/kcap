<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.Views.PageViewer"
             x:DataType="vm:PageViewerViewModel"
             Background="{StaticResource KcapCanvasBrush}">
    <Grid RowDefinitions="Auto,*">
        <Border x:Name="PendingBar" IsVisible="{Binding HasPending}" Padding="24,8"
                Background="{StaticResource KcapWarningDimBrush}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock x:Name="PendingPrompt" Text="{Binding PendingPrompt}" ToolTip.Tip="{Binding PendingExternalUrl}"
                           FontSize="{StaticResource KcapFontSizeSmall}" Foreground="{StaticResource KcapWarningBrush}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button x:Name="OpenPending" Grid.Column="1" Classes="kcapGhost" Content="Open"
                        Command="{Binding OpenPendingCommand}" />
                <Button x:Name="DismissPending" Grid.Column="2" Classes="kcapGhost" Content="Dismiss"
                        Command="{Binding DismissPendingCommand}" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" IsVisible="{Binding !IsReady}" Margin="24,20" Spacing="12">
            <TextBlock x:Name="PageNotice" Text="{Binding Notice}"
                       FontSize="{StaticResource KcapFontSizeBody}" Foreground="{StaticResource KcapMutedBrush}" TextWrapping="Wrap" />
            <Button x:Name="Retry" Classes="kcapPrimary" Content="Retry" HorizontalAlignment="Left"
                    IsVisible="{Binding CanRetry}" Command="{Binding ReloadCommand}" />
        </StackPanel>
        <ContentControl x:Name="WebHost" Grid.Row="1" IsVisible="{Binding IsReady}" />
    </Grid>
</UserControl>
