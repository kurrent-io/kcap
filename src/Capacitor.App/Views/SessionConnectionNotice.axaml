<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Capacitor.App.ViewModels"
             xmlns:views="clr-namespace:Capacitor.App.Views"
             x:Class="Capacitor.App.Views.SessionConnectionNotice"
             x:DataType="vm:SessionConnectionPresentation">
    <Border Margin="20,10,20,0" Padding="14,12" CornerRadius="10"
            Background="{StaticResource KcapSurfaceBrush}"
            BorderBrush="{StaticResource KcapBorderBrush}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <views:AppIcon Kind="LoaderCircle" Size="16" Margin="0,2,0,0" VerticalAlignment="Top"
                           IsVisible="{Binding IsBusy}" Foreground="{StaticResource KcapMutedBrush}" />
            <views:AppIcon Kind="CircleAlert" Size="16" Margin="0,2,0,0" VerticalAlignment="Top"
                           IsVisible="{Binding !IsBusy}" Foreground="{StaticResource KcapWarningBrush}" />
            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock x:Name="SessionNoticeTitle" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{StaticResource KcapTextBrush}" />
                <TextBlock Text="{Binding Detail}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource KcapMutedBrush}" />
                <Button Classes="kcapGhost" Content="{Binding ActionLabel}" Command="{Binding Action}"
                        IsVisible="{Binding HasAction}" HorizontalAlignment="Left" Margin="-8,2,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
